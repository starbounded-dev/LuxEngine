<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates the manual's C# API reference (Editor/Resources/Docs/api) from the built ScriptCore.dll and
       its XML documentation. A build tool for engine developers; game makers never run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
