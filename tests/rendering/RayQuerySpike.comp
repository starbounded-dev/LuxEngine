#version 460
#extension GL_EXT_ray_query : require

// GI0 spike: one ray query per invocation against a TLAS; writes the committed hit distance (or -1).
layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_Scene;

struct Ray
{
	vec4 OriginTMin;
	vec4 DirectionTMax;
};

layout(set = 0, binding = 1, std430) readonly buffer Rays { Ray rays[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Hits { vec4 hits[]; }; // x = t (or -1), y = hit flag, zw = geometric normal xy

layout(push_constant) uniform Push { uint u_RayCount; } push;

void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if (i >= push.u_RayCount)
		return;

	const Ray ray = rays[i];
	rayQueryEXT query;
	rayQueryInitializeEXT(query, u_Scene, gl_RayFlagsOpaqueEXT, 0xFF, ray.OriginTMin.xyz, ray.OriginTMin.w, ray.DirectionTMax.xyz, ray.DirectionTMax.w);
	while (rayQueryProceedEXT(query)) {}

	if (rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
		hits[i] = vec4(rayQueryGetIntersectionTEXT(query, true), 1.0, 0.0, 0.0);
	else
		hits[i] = vec4(-1.0, 0.0, 0.0, 0.0);
}
