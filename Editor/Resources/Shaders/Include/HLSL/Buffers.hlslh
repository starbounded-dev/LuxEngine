#pragma once

struct Camera
{
	float4x4 ViewProjectionMatrix;
	float4x4 InverseViewProjectionMatrix;
	float4x4 ProjectionMatrix;
	float4x4 InverseProjectionMatrix;
	float4x4 ViewMatrix;
	float4x4 InverseViewMatrix;
	float2 NDCToViewMul;
	float2 NDCToViewAdd;
	float2 DepthUnpackConsts;
	float2 CameraTanHalfFOV;
	float4x4 UnjitteredViewProjectionMatrix;
	float4x4 PreviousViewProjectionMatrix;
	float2 Jitter;
	float2 PreviousJitter;
	int IsOrthographic; // DepthUnpackConsts is then affine: depth = x * deviceDepth + y
};
[[vk::binding(0,2)]] ConstantBuffer<Camera> u_Camera;

struct ScreenData
{
    float2 InvFullResolution;
    float2 FullResolution;
    float2 InvHalfResolution;
    float2 HalfResolution;
};
[[vk::binding(2,2)]] ConstantBuffer<ScreenData> u_ScreenData;
 