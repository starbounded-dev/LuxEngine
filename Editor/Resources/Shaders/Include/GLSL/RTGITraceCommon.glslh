layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#ifdef LUX_RTGI_NRD
float g_NrdHitDistance;
#endif
#include <PathTraceCommon.glslh>

// Identical to the Camera block in Buffers.glslh (same (set,binding), same name).
layout(std140, set = 2, binding = 0) uniform Camera
{
	mat4 ViewProjectionMatrix;
	mat4 InverseViewProjectionMatrix;
	mat4 ProjectionMatrix;
	mat4 InverseProjectionMatrix;
	mat4 ViewMatrix;
	mat4 InverseViewMatrix;
	vec2 NDCToViewMul;
	vec2 NDCToViewAdd;
	vec2 DepthUnpackConsts;
	vec2 CameraTanHalfFOV;
	mat4 UnjitteredViewProjectionMatrix;
	mat4 PreviousViewProjectionMatrix;
	vec2 Jitter;
	vec2 PreviousJitter;
	int IsOrthographic;
} u_Camera;

layout(rgba16f, set = 1, binding = 90) uniform image2D o_RTGIAccum;                // rgb mean incident radiance, a = 1 where a surface was hit
layout(rgba16f, set = 1, binding = 91) uniform writeonly image2D o_RTGIAlbedo;     // rgb albedo * (1 - metalness), a = hit distance
layout(rgba16f, set = 1, binding = 92) uniform writeonly image2D o_RTGINormal;     // xyz world normal

#ifdef LUX_RTGI_NRD
layout(rgba16f, set = 1, binding = 181) uniform writeonly image2D o_NRDRadiance;
layout(rgba16f, set = 1, binding = 182) uniform writeonly image2D o_NRDNormalRoughness;
layout(r32f,    set = 1, binding = 183) uniform writeonly image2D o_NRDViewDepth;
layout(rg16f,   set = 1, binding = 184) uniform writeonly image2D o_NRDMotion;

void WriteNRDGuides(ivec2 pixel, vec2 uv, Surface surface, vec3 incident)
{
	vec4 previousClip = u_Camera.PreviousViewProjectionMatrix * vec4(surface.P, 1.0);
	vec2 previousUV = previousClip.w > 0.0 ? previousClip.xy / previousClip.w * vec2(0.5, -0.5) + 0.5 : uv;
	float viewDepth = -(u_Camera.ViewMatrix * vec4(surface.P, 1.0)).z;
	vec3 normal = surface.N / max(abs(surface.N.x), max(abs(surface.N.y), abs(surface.N.z)));
	imageStore(o_NRDRadiance, pixel, vec4(incident, g_NrdHitDistance));
	imageStore(o_NRDNormalRoughness, pixel, vec4(normal * 0.5 + 0.5, surface.Rough));
	imageStore(o_NRDViewDepth, pixel, vec4(viewDepth));
	imageStore(o_NRDMotion, pixel, vec4(previousUV - uv, 0.0, 0.0));
}
#endif

void main()
{
	const uvec2 pixel = gl_GlobalInvocationID.xy;
	if (pixel.x >= u_Push.SizeFrameBounces.x || pixel.y >= u_Push.SizeFrameBounces.y)
		return;

	const uint frame = u_Push.SizeFrameBounces.z;
	g_Rng = PCG(pixel.x + PCG(pixel.y + PCG(frame * 6151u + 11u)));

	// Pixel centre (a stable surface per pixel; the noise is in the indirect sample, not the geometry).
	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_Push.SizeFrameBounces.xy);
	vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
	vec4 viewPoint = u_Camera.InverseProjectionMatrix * vec4(ndc, 1.0, 1.0);
	vec3 viewDir = normalize(viewPoint.xyz / viewPoint.w);
	vec3 origin = u_Camera.InverseViewMatrix[3].xyz;
	vec3 dir = normalize((u_Camera.InverseViewMatrix * vec4(viewDir, 0.0)).xyz);

	g_InitialConeAngle = 2.0 / (u_Camera.ProjectionMatrix[1][1] * float(u_Push.SizeFrameBounces.y));
	Surface s;
	if (!TraceClosest(origin, dir, s))
	{
		imageStore(o_RTGIAccum, ivec2(pixel), vec4(0.0));
		imageStore(o_RTGIAlbedo, ivec2(pixel), vec4(0.0));
		imageStore(o_RTGINormal, ivec2(pixel), vec4(0.0));
#ifdef LUX_RTGI_NRD
		imageStore(o_NRDRadiance, ivec2(pixel), vec4(0.0));
		imageStore(o_NRDNormalRoughness, ivec2(pixel), vec4(0.5, 0.5, 1.0, 1.0));
		imageStore(o_NRDViewDepth, ivec2(pixel), vec4(1.0e6));
		imageStore(o_NRDMotion, ivec2(pixel), vec4(0.0));
#endif
		return;
	}

	vec3 t, b;
	Basis(s.N, t, b);
	float u1 = Rand(), u2 = Rand();
	float r = sqrt(u1);
	float phi = 2.0 * PI * u2;
	vec3 sampleDir = normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + s.N * sqrt(max(1.0 - u1, 0.0)));

	vec3 incident = TracePath(s.P + s.N * 2e-3, sampleDir, u_Push.SizeFrameBounces.w);
	float peak = max(incident.r, max(incident.g, incident.b));
	if (peak > 16.0)
		incident *= 16.0 / peak;

	// Running mean that settles to a 1/32 exponential average, restarting at frame 0.
	float alpha = frame == 0u ? 1.0 : max(1.0 / float(frame + 1u), 1.0 / float(max(u_Push.Counts.w, 1u)));
	vec3 history = alpha < 1.0 ? mix(imageLoad(o_RTGIAccum, ivec2(pixel)).rgb, incident, alpha) : incident;
	imageStore(o_RTGIAccum, ivec2(pixel), vec4(history, 1.0));
	imageStore(o_RTGIAlbedo, ivec2(pixel), vec4(s.Albedo * (1.0 - s.Metal), length(s.P - origin)));
	imageStore(o_RTGINormal, ivec2(pixel), vec4(s.N, 0.0));
#ifdef LUX_RTGI_NRD
	WriteNRDGuides(ivec2(pixel), uv, s, incident);
#endif
}
