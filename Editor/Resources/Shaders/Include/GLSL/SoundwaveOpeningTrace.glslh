#include "SoundwaveGeometry.glslh"
bool Finite(vec3 value)
{
	return !any(isnan(value)) && !any(isinf(value));
}

// Mirrors Solve.cpp's analytic clipping of a portal in unit-box coordinates.
bool ClipPortal(vec3 from, vec3 to, float lengthWorld, float margin)
{
	const vec3 direction = to - from;
	float start = 0.0, end = 1.0;
	for (int axis = 0; axis < 3; ++axis)
	{
		const float delta = direction[axis];
		if (abs(delta) < 1e-8)
		{
			if (from[axis] < -1.0 || from[axis] > 1.0)
				return false;
			continue;
		}
		const float a = (-1.0 - from[axis]) / delta;
		const float b = (1.0 - from[axis]) / delta;
		start = max(start, min(a, b));
		end = min(end, max(a, b));
		if (start >= end)
			return false;
	}
	return end * lengthWorld > margin && start * lengthWorld < lengthWorld - margin;
}

uint SegmentTrace(vec3 from, vec3 to, float margin)
{
	float span = length(to - from);
	if (!Finite(from) || !Finite(to) || isnan(span) || isinf(span))
		return 2u;
	if (Soundwave_AnyHit(requestBlock.Geometry.xy, from, to, requestBlock.Geometry.zw, margin))
		return 1u;
	for (uint i = 0u; i < requestBlock.Initial.w; ++i)
	{
		SoundwaveOpeningPortal portal = Portals[i];
		if (portal.Instance.z == 0u || portal.Instance.xy == requestBlock.Geometry.zw)
			continue;
		vec3 a = (portal.WorldToBox * vec4(from, 1.0)).xyz, b = (portal.WorldToBox * vec4(to, 1.0)).xyz;
		if (!Finite(a) || !Finite(b) || !Finite(b - a))
			return 2u;
		if (ClipPortal(a, b, span, margin))
			return 1u;
	}
	return 0u;
}

uint OpeningTrace(vec3 from, vec3 to)
{
	return SegmentTrace(from, to, 0.0);
}
