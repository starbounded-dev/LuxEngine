#ifndef LUX_GBUFFER_GLSLH
#define LUX_GBUFFER_GLSLH

#include <Samplers.glslh>

struct LuxGBufferData
{
	vec3 BaseColor;
	float Opacity;
	vec3 ViewNormal;
	// Diffuse transmission factor (material factor x map); its colour is in the material row.
	float DiffuseTransmission;
	float Metalness;
	float Roughness;
	float AmbientOcclusion;
	float Specular;
	uint MaterialID;
	uint ObjectID;
};

void EncodeGBuffer(
	LuxGBufferData data,
	out vec4 outBaseColorOpacity,
	out vec4 outViewNormal,
	out vec4 outMetalRoughAO,
	out uvec2 outMaterialObjectID)
{
	outBaseColorOpacity = vec4(max(data.BaseColor, vec3(0.0)), clamp(data.Opacity, 0.0, 1.0));
	outViewNormal = vec4(normalize(data.ViewNormal), clamp(data.DiffuseTransmission, 0.0, 1.0));
	outMetalRoughAO = vec4(
		clamp(data.Metalness, 0.0, 1.0),
		clamp(data.Roughness, 0.0, 1.0),
		clamp(data.AmbientOcclusion, 0.0, 1.0),
		clamp(data.Specular, 0.0, 1.0));
	outMaterialObjectID = uvec2(data.MaterialID, data.ObjectID);
}

LuxGBufferData DecodeGBuffer(
	texture2D gBufferBaseColor,
	texture2D gBufferNormal,
	texture2D gBufferMetalRoughAO,
	utexture2D gBufferMaterialObjectID,
	vec2 uv)
{
	LuxGBufferData data;
	vec4 baseColorOpacity = texture(sampler2D(gBufferBaseColor, r_PointSampler), uv);
	vec4 normalData = texture(sampler2D(gBufferNormal, r_PointSampler), uv);
	vec4 metalRoughAO = texture(sampler2D(gBufferMetalRoughAO, r_PointSampler), uv);

	data.BaseColor = baseColorOpacity.rgb;
	data.Opacity = baseColorOpacity.a;
	data.ViewNormal = normalize(normalData.xyz);
	data.DiffuseTransmission = normalData.w;
	data.Metalness = metalRoughAO.x;
	data.Roughness = max(metalRoughAO.y, 0.05);
	data.AmbientOcclusion = metalRoughAO.z;
	data.Specular = metalRoughAO.w;
	uvec2 materialObjectID = texture(usampler2D(gBufferMaterialObjectID, r_PointSampler), uv).rg;
	data.MaterialID = materialObjectID.x;
	data.ObjectID = materialObjectID.y;

	return data;
}

// An orthonormal pair perpendicular to unit `n`, from `n` alone [Duff et al. 2017], so the G-buffer
// pass and deferred lighting build the same one.
void LuxGBufferNormalBasis(vec3 n, out vec3 b1, out vec3 b2)
{
	float s = n.z >= 0.0 ? 1.0 : -1.0;
	float a = -1.0 / (s + n.z);
	float b = n.x * n.y * a;
	b1 = vec3(1.0 + s * n.x * n.x * a, s * b, -s * n.x);
	b2 = vec3(b, s + n.y * n.y * a, -n.y);
}

// Anisotropic materials keep their tangent in the base colour's alpha, which the opaque passes do not
// otherwise read: its angle about the view normal in that basis, over [0, pi) (the lobe is the same
// for T and -T), as 0..1.
float EncodeGBufferTangent(vec3 viewNormal, vec3 viewTangent)
{
	vec3 b1, b2;
	LuxGBufferNormalBasis(viewNormal, b1, b2);
	float angle = atan(dot(viewTangent, b2), dot(viewTangent, b1));
	if (angle < 0.0)
		angle += 3.14159265;
	return clamp(angle / 3.14159265, 0.0, 1.0);
}

vec3 DecodeGBufferTangent(vec3 viewNormal, float encoded)
{
	vec3 b1, b2;
	LuxGBufferNormalBasis(viewNormal, b1, b2);
	float angle = encoded * 3.14159265;
	return cos(angle) * b1 + sin(angle) * b2;
}

vec3 GBufferDebugColorFromID(uint id)
{
	id ^= id >> 16u;
	id *= 0x7feb352du;
	id ^= id >> 15u;
	id *= 0x846ca68bu;
	id ^= id >> 16u;

	return vec3(
		float((id >> 0u) & 0xffu),
		float((id >> 8u) & 0xffu),
		float((id >> 16u) & 0xffu)) / 255.0;
}

#endif // LUX_GBUFFER_GLSLH
