#ifndef LUX_LIGHTING_GLSLH
#define LUX_LIGHTING_GLSLH

#pragma stage : frag
#include <Common.glslh>
#include <Buffers.glslh>
#include <Cluster.glslh>
#include <PBR.glslh>

// Clustered (froxel) light lists, produced by ClusterLightCulling.glsl.
layout(std430, set = 1, binding = 22) readonly buffer PointLightGridBuffer
{
	uvec2 Grid[]; // (offset, count)
} s_PointLightGrid;

layout(std430, set = 1, binding = 23) readonly buffer SpotLightGridBuffer
{
	uvec2 Grid[];
} s_SpotLightGrid;

layout(std430, set = 1, binding = 24) readonly buffer PointLightIndexListBuffer
{
	uint Indices[];
} s_PointLightIndexList;

layout(std430, set = 1, binding = 25) readonly buffer SpotLightIndexListBuffer
{
	uint Indices[];
} s_SpotLightIndexList;

// Per-fragment cluster light ranges, populated by SetupClusterLights().
uint g_PointLightOffset = 0u;
uint g_PointLightCount  = 0u;
uint g_SpotLightOffset  = 0u;
uint g_SpotLightCount   = 0u;

// Resolve the froxel for this fragment from its world position and cache the
// per-cluster point/spot light ranges. Must be called before GetPoint/Spot*().
void SetupClusterLights(vec3 worldPos)
{
	// Positive linear view depth (camera looks down -Z), matching ClusterBuild.
	float linearDepth = -(u_Camera.ViewMatrix * vec4(worldPos, 1.0)).z;
	uint zSlice = ClusterZSlice(linearDepth, u_RendererData.ClusterZParams.x, u_RendererData.ClusterZParams.y);

	vec2 clusterPx = u_ScreenData.FullResolution / vec2(float(CLUSTER_GRID_X), float(CLUSTER_GRID_Y));
	uvec2 xy = uvec2(clamp(gl_FragCoord.xy / clusterPx,
		vec2(0.0), vec2(float(CLUSTER_GRID_X - 1), float(CLUSTER_GRID_Y - 1))));

	uint cluster = ClusterFlatten(uvec3(xy, zSlice));

	uvec2 pointRange = s_PointLightGrid.Grid[cluster];
	g_PointLightOffset = pointRange.x;
	g_PointLightCount  = pointRange.y;

	uvec2 spotRange = s_SpotLightGrid.Grid[cluster];
	g_SpotLightOffset = spotRange.x;
	g_SpotLightCount  = spotRange.y;
}

// Used in PBR shader
struct PBRParameters
{
	vec3 Albedo;
	float Roughness;
	float Metalness;

	vec3 Normal;
	vec3 View;
	float NdotV;
} m_Params;

vec3 CalculateDirLights(vec3 F0)
{
	vec3 result = vec3(0.0);
	for (int i = 0; i < 1; i++) //Only one light for now
	{
		if (u_Scene.DirectionalLights.Multiplier == 0.0)
			continue;

		vec3 Li = u_Scene.DirectionalLights.Direction;
		vec3 Lradiance = u_Scene.DirectionalLights.Radiance * u_Scene.DirectionalLights.Multiplier;
		result += LuxEvaluateDirectBRDF(F0, m_Params.Albedo, m_Params.Metalness, m_Params.Roughness, m_Params.Normal, m_Params.View, Li) * Lradiance;
	}
	return result;
}

//////////////////////////////////////////
// POINT LIGHT
//////////////////////////////////////////


int GetPointLightCount()
{
	return int(g_PointLightCount);
}

int GetPointLightBufferIndex(int i)
{
	if (uint(i) >= g_PointLightCount)
		return -1;
	return int(s_PointLightIndexList.Indices[g_PointLightOffset + uint(i)]);
}

vec3 CalculatePointLights(in vec3 F0, vec3 worldPos)
{
	SetupClusterLights(worldPos);
	vec3 result = vec3(0.0);
	for (int i = 0; i < GetPointLightCount(); i++)
	{
		int visibleIndex = GetPointLightBufferIndex(i);
		if (visibleIndex < 0)
			break;

		uint lightIndex = uint(visibleIndex);

		PointLight light = u_PointLights.Lights[lightIndex];
		vec3 toLight = light.Position - worldPos;
		float distanceSq = dot(toLight, toLight);
		vec3 Li = toLight * inversesqrt(max(distanceSq, 1e-12));

		float attenuation = LuxPunctualLightAttenuation(distanceSq, light.Radius);
		vec3 Lradiance = light.Radiance * light.Multiplier * attenuation;
		result += LuxEvaluateDirectBRDF(F0, m_Params.Albedo, m_Params.Metalness, m_Params.Roughness, m_Params.Normal, m_Params.View, Li) * Lradiance;
	}
	return result;
}


//////////////////////////////////////////
// SPOT LIGHT
//////////////////////////////////////////

int GetSpotLightCount()
{
	return int(g_SpotLightCount);
}

int GetSpotLightBufferIndex(int i)
{
	if (uint(i) >= g_SpotLightCount)
		return -1;
	return int(s_SpotLightIndexList.Indices[g_SpotLightOffset + uint(i)]);
}

vec3 CalculateSpotLights(in vec3 F0, vec3 worldPos)
{
	SetupClusterLights(worldPos);
	vec3 result = vec3(0.0);
	for (int i = 0; i < GetSpotLightCount(); i++)
	{
		int visibleIndex = GetSpotLightBufferIndex(i);
		if (visibleIndex < 0)
			break;

		uint lightIndex = uint(visibleIndex);

		SpotLight light = u_SpotLights.Lights[lightIndex];
		vec3 toLight = light.Position - worldPos;
		float distanceSq = dot(toLight, toLight);
		vec3 Li = toLight * inversesqrt(max(distanceSq, 1e-12));

		float cutoff = cos(radians(light.Angle * 0.5f));
		float scos = max(dot(-Li, normalize(light.Direction)), cutoff);
		float rim = (1.0 - scos) / (1.0 - cutoff);

		float attenuation = LuxPunctualLightAttenuation(distanceSq, light.Range);
		attenuation *= 1.0 - pow(max(rim, 0.001), light.AngleAttenuation);

		vec3 Lradiance = light.Radiance * light.Multiplier * attenuation;
		result += LuxEvaluateDirectBRDF(F0, m_Params.Albedo, m_Params.Metalness, m_Params.Roughness, m_Params.Normal, m_Params.View, Li) * Lradiance;
	}
	return result;
}

#endif // LUX_LIGHTING_GLSLH
