// Area lights with Linearly Transformed Cosines [Heitz, Dupuy, Hill, Neubelt 2016, "Real-Time
// Polygonal-Light Shading with Linearly Transformed Cosines"]. The edge integral, the table
// parameterisation and the horizon handling follow the authors' reference code
// (github.com/selfshadow/ltc_code, BSD-2-Clause, see Core/vendor/ltc/LICENSE); the tables are
// Renderer::GetLTCMatrixTexture / GetLTCAmplitudeTexture.
//
// The area-light pass and the transparent forward pass include this file; both bind AreaLightData and
// the tables.

#ifndef LUX_LTC_GLSLH
#define LUX_LTC_GLSLH

#include <Samplers.glslh>

const uint AREA_LIGHT_SHAPE_RECT = 0u; // AreaLightShape in Components.h
const uint AREA_LIGHT_SHAPE_DISK = 1u;
const uint AREA_LIGHT_SHAPE_SPHERE = 2u;
const uint AREA_LIGHT_SHAPE_TUBE = 3u;
const uint AREA_LIGHT_TWO_SIDED = 1u;  // AreaLightFlags in SceneRenderer.h

#define MAX_AREA_LIGHTS 32 // LightEnvironment::MaxAreaLights

// Mirrors SceneRenderer.h AreaLight (64 bytes). A rect or disk emits along
// -normalize(cross(HalfRight, HalfUp)); a sphere's radius is length(HalfRight); a tube's axis and
// half-length are HalfRight and its radius length(HalfUp).
struct AreaLight
{
	vec3 Position;
	float Intensity; // luminance
	vec3 Radiance;
	float Range;
	vec3 HalfRight;
	uint Shape;
	vec3 HalfUp;
	uint Flags;
};

layout(std140, set = 1, binding = 18) uniform AreaLightData
{
	uint LightCount;
	AreaLight Lights[MAX_AREA_LIGHTS];
} u_AreaLights;

// 64x64 RGBA16F. Matrix: the inverse LTC matrix's (m00, m02, m20, m22), normalised by m11.
// Amplitude: x = BRDF norm, y = Fresnel term, w = horizon-clipped sphere form factor.
layout(set = 3, binding = 6) uniform texture2D u_LTCMatrixTexture;
layout(set = 3, binding = 7) uniform texture2D u_LTCAmplitudeTexture;

const float LTC_LUT_SIZE = 64.0;
const float LTC_LUT_SCALE = (LTC_LUT_SIZE - 1.0) / LTC_LUT_SIZE;
const float LTC_LUT_BIAS = 0.5 / LTC_LUT_SIZE;

// A disk is integrated as a regular polygon whose circumradius is scaled so its area matches.
const int LTC_DISK_VERTICES = 12;
const float LTC_DISK_RADIUS_SCALE = 1.0233267; // sqrt(2 pi / (12 sin(2 pi / 12)))

vec2 LTC_TableCoords(vec2 uv)
{
	return uv * LTC_LUT_SCALE + LTC_LUT_BIAS;
}

// Vector form factor of one polygon edge between two unit vectors: cross(v1, v2) scaled by a fit of
// theta / (2 pi sin(theta)), so the 1 / (2 pi) of the form factor is already in.
vec3 LTC_IntegrateEdge(vec3 v1, vec3 v2)
{
	float x = dot(v1, v2);
	float y = abs(x);
	float a = 0.8543985 + (0.4965155 + 0.0145206 * y) * y;
	float b = 3.4175940 + (4.1616724 + y) * y;
	float v = a / b;
	float thetaOverSinTheta = (x > 0.0) ? v : 0.5 * inversesqrt(max(1.0 - x * x, 1e-7)) - v;
	return cross(v1, v2) * thetaOverSinTheta;
}

// Form factor of a polygon from its vector form factor, clipped to the horizon through the
// fitted sphere approximation.
float LTC_FormFactor(vec3 vectorFormFactor)
{
	float len = length(vectorFormFactor);
	if (len <= 1e-6)
		return 0.0;

	float z = vectorFormFactor.z / len;
	vec2 uv = LTC_TableCoords(vec2(z * 0.5 + 0.5, len));
	return len * texture(sampler2D(u_LTCAmplitudeTexture, r_LinearSampler), uv).w;
}

// World -> the shading point's (T1, T2, N) frame, T1 in the plane of N and V.
mat3 LTC_ShadingFrame(vec3 N, vec3 V)
{
	vec3 T1 = V - N * dot(V, N);
	if (dot(T1, T1) < 1e-8)
		T1 = abs(N.z) < 0.999 ? cross(N, vec3(0.0, 0.0, 1.0)) : cross(N, vec3(1.0, 0.0, 0.0));
	T1 = normalize(T1);
	vec3 T2 = cross(N, T1);
	return transpose(mat3(T1, T2, N));
}

// Vector form factor of the light's polygon after `transform` (a shading frame, or the LTC matrix
// times it). Vertices wind counter-clockwise around cross(HalfRight, HalfUp), which faces away from
// the emitting side, so a point on the emitting side sees a positive z.
vec3 LTC_PolygonFormFactor(AreaLight light, vec3 worldPosition, mat3 transform)
{
	vec3 toCenter = light.Position - worldPosition;
	vec3 sum = vec3(0.0);
	if (light.Shape == AREA_LIGHT_SHAPE_DISK)
	{
		vec3 right = light.HalfRight * LTC_DISK_RADIUS_SCALE;
		vec3 up = light.HalfUp * LTC_DISK_RADIUS_SCALE;
		vec3 first = normalize(transform * (toCenter + right));
		vec3 previous = first;
		for (int i = 1; i < LTC_DISK_VERTICES; i++)
		{
			float angle = 6.28318531 * float(i) / float(LTC_DISK_VERTICES);
			vec3 current = normalize(transform * (toCenter + right * cos(angle) + up * sin(angle)));
			sum += LTC_IntegrateEdge(previous, current);
			previous = current;
		}
		sum += LTC_IntegrateEdge(previous, first);
	}
	else
	{
		vec3 l0 = normalize(transform * (toCenter - light.HalfRight - light.HalfUp));
		vec3 l1 = normalize(transform * (toCenter + light.HalfRight - light.HalfUp));
		vec3 l2 = normalize(transform * (toCenter + light.HalfRight + light.HalfUp));
		vec3 l3 = normalize(transform * (toCenter - light.HalfRight + light.HalfUp));
		sum = LTC_IntegrateEdge(l0, l1) + LTC_IntegrateEdge(l1, l2) + LTC_IntegrateEdge(l2, l3) + LTC_IntegrateEdge(l3, l0);
	}
	return sum;
}

// Any vector perpendicular to the unit vector n.
vec3 LTC_Perpendicular(vec3 n)
{
	return normalize(abs(n.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), n) : cross(vec3(1.0, 0.0, 0.0), n));
}

// A sphere seen from a point is a disk facing it, and a tube (a capsule) is close to a rectangle
// facing it around its axis, lengthened by pi r / 4 at each end so it keeps the capsule silhouette's
// area. Both are built facing worldPosition (cross(HalfRight, HalfUp) points away from it), so the
// flat-shape integral applies with no back side.
AreaLight LTC_FacingShape(AreaLight light, vec3 worldPosition)
{
	vec3 toPoint = worldPosition - light.Position;
	AreaLight facing = light;
	if (light.Shape == AREA_LIGHT_SHAPE_SPHERE)
	{
		float radius = length(light.HalfRight);
		vec3 n = dot(toPoint, toPoint) > 1e-8 ? normalize(toPoint) : vec3(0.0, 1.0, 0.0);
		vec3 right = LTC_Perpendicular(n);
		facing.HalfRight = right * radius;
		facing.HalfUp = cross(right, n) * radius;
		facing.Shape = AREA_LIGHT_SHAPE_DISK;
	}
	else
	{
		float radius = length(light.HalfUp);
		float halfLength = length(light.HalfRight);
		vec3 axis = halfLength > 1e-6 ? light.HalfRight / halfLength : vec3(1.0, 0.0, 0.0);
		vec3 n = toPoint - axis * dot(toPoint, axis);
		n = dot(n, n) > 1e-8 ? normalize(n) : LTC_Perpendicular(axis);
		facing.HalfRight = axis * (halfLength + 0.78539816 * radius);
		facing.HalfUp = cross(axis, n) * radius;
		facing.Shape = AREA_LIGHT_SHAPE_RECT;
	}
	facing.Flags = 0u;
	return facing;
}

// Outgoing radiance from every area light at a surface point: Lambert diffuse and GGX specular.
vec3 LuxEvaluateAreaLights(vec3 worldPosition, vec3 N, vec3 V, vec3 albedo, float metalness, float roughness, vec3 F0)
{
	float NdotV = clamp(dot(N, V), 1e-4, 1.0);
	vec2 uv = LTC_TableCoords(vec2(roughness, sqrt(1.0 - NdotV)));
	vec4 matrixTerms = texture(sampler2D(u_LTCMatrixTexture, r_LinearSampler), uv);
	vec4 amplitude = texture(sampler2D(u_LTCAmplitudeTexture, r_LinearSampler), uv);

	mat3 frame = LTC_ShadingFrame(N, V);
	mat3 specularTransform = mat3(
		vec3(matrixTerms.x, 0.0, matrixTerms.y),
		vec3(0.0, 1.0, 0.0),
		vec3(matrixTerms.z, 0.0, matrixTerms.w)) * frame;
	vec3 specularScale = F0 * amplitude.x + (1.0 - F0) * amplitude.y;
	vec3 diffuseColor = albedo * (1.0 - metalness);

	vec3 result = vec3(0.0);
	uint count = min(u_AreaLights.LightCount, uint(MAX_AREA_LIGHTS));
	for (uint i = 0u; i < count; i++)
	{
		AreaLight light = u_AreaLights.Lights[i];
		vec3 fromLight = worldPosition - light.Position;
		float distanceSq = dot(fromLight, fromLight);
		float ratio = distanceSq / max(light.Range * light.Range, 1e-4);
		float window = clamp(1.0 - ratio * ratio, 0.0, 1.0);
		window *= window;
		if (window <= 0.0)
			continue;

		bool front = true;
		if (light.Shape == AREA_LIGHT_SHAPE_SPHERE || light.Shape == AREA_LIGHT_SHAPE_TUBE)
		{
			light = LTC_FacingShape(light, worldPosition);
		}
		else
		{
			vec3 emitDirection = -cross(light.HalfRight, light.HalfUp);
			front = dot(fromLight, emitDirection) > 0.0;
			if (!front && (light.Flags & AREA_LIGHT_TWO_SIDED) == 0u)
				continue;
		}

		// Seen from behind, the polygon winds the other way.
		float facing = front ? 1.0 : -1.0;
		float diffuse = LTC_FormFactor(facing * LTC_PolygonFormFactor(light, worldPosition, frame));
		float specular = LTC_FormFactor(facing * LTC_PolygonFormFactor(light, worldPosition, specularTransform));
		result += light.Radiance * (light.Intensity * window) * (diffuseColor * diffuse + specularScale * specular);
	}
	return result;
}

#endif
