#ifndef LUX_MATERIAL_SCENE_GLSLH
#define LUX_MATERIAL_SCENE_GLSLH

#define GPU_TEXTURE_SCENE_MAX_TEXTURES 1024
#define GPU_MATERIAL_SCENE_AVAILABLE 1

struct GPUMaterial
{
	vec4 BaseColor;
	vec4 Scalars;        // x = metalness, y = roughness, z = emission, w = material complexity
	uvec4 TextureIndices; // x = albedo, y = normal, z = metalness, w = roughness
	uvec4 Metadata;       // x = flags, y = alpha mode, z = RenderMaterialID, w = floatBits(env map rotation)
};

layout(std430, set = 2, binding = 7) readonly buffer GPUMaterials
{
	GPUMaterial Materials[];
} r_GPUMaterials;

layout(set = 2, binding = 8) uniform texture2D u_GPUMaterialTextures[GPU_TEXTURE_SCENE_MAX_TEXTURES];

const uint GPU_TEXTURE_INVALID_INDEX = 0xffffffffu;

const uint GPU_MATERIAL_FLAG_VALID = 1u << 0u;
const uint GPU_MATERIAL_FLAG_MISSING = 1u << 1u;
const uint GPU_MATERIAL_FLAG_TRANSPARENT = 1u << 2u;
const uint GPU_MATERIAL_FLAG_SHADOW_CASTING = 1u << 3u;
const uint GPU_MATERIAL_FLAG_TWO_SIDED = 1u << 4u;
const uint GPU_MATERIAL_FLAG_USE_NORMAL_MAP = 1u << 5u;
const uint GPU_MATERIAL_FLAG_HAS_ALBEDO_TEXTURE = 1u << 6u;
const uint GPU_MATERIAL_FLAG_HAS_NORMAL_TEXTURE = 1u << 7u;
const uint GPU_MATERIAL_FLAG_HAS_METALNESS_TEXTURE = 1u << 8u;
const uint GPU_MATERIAL_FLAG_HAS_ROUGHNESS_TEXTURE = 1u << 9u;
const uint GPU_MATERIAL_FLAG_MISSING_TEXTURE = 1u << 10u;
const uint GPU_MATERIAL_FLAG_OVERRIDE_MATERIAL = 1u << 11u;

const uint GPU_MATERIAL_ALPHA_OPAQUE = 0u;
const uint GPU_MATERIAL_ALPHA_MASKED = 1u;
const uint GPU_MATERIAL_ALPHA_BLEND = 2u;

const uint GPU_MATERIAL_DEBUG_TEXTURE_VALIDITY = 6u;
const uint GPU_MATERIAL_DEBUG_ALPHA_MODE = 7u;
const uint GPU_MATERIAL_DEBUG_ROUGHNESS = 8u;
const uint GPU_MATERIAL_DEBUG_METALNESS = 9u;
const uint GPU_MATERIAL_DEBUG_MISSING = 10u;

bool HasGPUMaterialFlag(uint flags, uint flag)
{
	return (flags & flag) != 0u;
}

bool IsGPUTextureIndexValid(uint textureIndex)
{
	return textureIndex != GPU_TEXTURE_INVALID_INDEX && textureIndex < uint(GPU_TEXTURE_SCENE_MAX_TEXTURES);
}

GPUMaterial GetGPUMaterialForObject(uint objectIndex)
{
	return r_GPUMaterials.Materials[GetInstanceMaterialIndex(objectIndex)];
}

bool IsGPUMaterialRowUsable(GPUMaterial material)
{
	uint flags = material.Metadata.x;
	return HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_VALID)
		&& !HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_MISSING);
}

vec3 GetGPUMaterialBaseColor(GPUMaterial material, vec3 fallbackLinearBaseColor)
{
	return IsGPUMaterialRowUsable(material)
		? clamp(material.BaseColor.rgb, vec3(0.0), vec3(128.0))
		: fallbackLinearBaseColor;
}

float GetGPUMaterialOpacity(GPUMaterial material, float fallbackOpacity)
{
	return IsGPUMaterialRowUsable(material)
		? clamp(material.BaseColor.a, 0.0, 1.0)
		: clamp(fallbackOpacity, 0.0, 1.0);
}

float GetGPUMaterialMetalness(GPUMaterial material, float fallbackMetalness)
{
	return IsGPUMaterialRowUsable(material)
		? clamp(material.Scalars.x, 0.0, 1.0)
		: clamp(fallbackMetalness, 0.0, 1.0);
}

float GetGPUMaterialRoughness(GPUMaterial material, float fallbackRoughness)
{
	return IsGPUMaterialRowUsable(material)
		? clamp(material.Scalars.y, 0.0, 1.0)
		: clamp(fallbackRoughness, 0.0, 1.0);
}

float GetGPUMaterialEmission(GPUMaterial material, float fallbackEmission)
{
	return IsGPUMaterialRowUsable(material)
		? max(material.Scalars.z, 0.0)
		: max(fallbackEmission, 0.0);
}

float GetGPUMaterialComplexity(GPUMaterial material, float fallbackComplexity)
{
	return IsGPUMaterialRowUsable(material)
		? max(material.Scalars.w, 0.0)
		: max(fallbackComplexity, 0.0);
}

float GetGPUMaterialEnvMapRotation(GPUMaterial material, float fallbackRotation)
{
	return IsGPUMaterialRowUsable(material)
		? uintBitsToFloat(material.Metadata.w)
		: fallbackRotation;
}

uint GetGPUMaterialAlphaMode(GPUMaterial material, uint fallbackAlphaMode)
{
	return IsGPUMaterialRowUsable(material)
		? material.Metadata.y
		: fallbackAlphaMode;
}

bool GetGPUMaterialUsesNormalMap(GPUMaterial material, bool fallbackUseNormalMap)
{
	return IsGPUMaterialRowUsable(material)
		? HasGPUMaterialFlag(material.Metadata.x, GPU_MATERIAL_FLAG_USE_NORMAL_MAP)
		: fallbackUseNormalMap;
}

vec3 GetMaterialSceneDebugColorForMaterialID(uint materialID, uint mode)
{
	if (materialID == GPU_TEXTURE_INVALID_INDEX)
		return vec3(1.0, 0.0, 1.0);

	uint flags = r_GPUMaterials.Materials[materialID].Metadata.x;

	if (mode == GPU_MATERIAL_DEBUG_TEXTURE_VALIDITY)
	{
		GPUMaterial material = r_GPUMaterials.Materials[materialID];
		bool hasInvalidTextureIndex =
			(HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_ALBEDO_TEXTURE) && !IsGPUTextureIndexValid(material.TextureIndices.x)) ||
			(HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_NORMAL_TEXTURE) && !IsGPUTextureIndexValid(material.TextureIndices.y)) ||
			(HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_METALNESS_TEXTURE) && !IsGPUTextureIndexValid(material.TextureIndices.z)) ||
			(HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_ROUGHNESS_TEXTURE) && !IsGPUTextureIndexValid(material.TextureIndices.w));

		if (HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_MISSING_TEXTURE) || hasInvalidTextureIndex)
			return vec3(1.0, 0.05, 0.02);

		bool hasTexture =
			HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_ALBEDO_TEXTURE) ||
			HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_NORMAL_TEXTURE) ||
			HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_METALNESS_TEXTURE) ||
			HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_HAS_ROUGHNESS_TEXTURE);

		return hasTexture ? vec3(0.05, 0.85, 0.25) : vec3(0.18, 0.24, 0.34);
	}

	if (mode == GPU_MATERIAL_DEBUG_ALPHA_MODE)
	{
		uint alphaMode = r_GPUMaterials.Materials[materialID].Metadata.y;
		if (alphaMode == GPU_MATERIAL_ALPHA_BLEND)
			return vec3(0.95, 0.65, 0.08);
		if (alphaMode == GPU_MATERIAL_ALPHA_MASKED)
			return vec3(0.72, 0.25, 1.0);
		return vec3(0.06, 0.45, 1.0);
	}

	if (mode == GPU_MATERIAL_DEBUG_ROUGHNESS)
		return vec3(clamp(r_GPUMaterials.Materials[materialID].Scalars.y, 0.0, 1.0));

	if (mode == GPU_MATERIAL_DEBUG_METALNESS)
		return vec3(clamp(r_GPUMaterials.Materials[materialID].Scalars.x, 0.0, 1.0));

	if (mode == GPU_MATERIAL_DEBUG_MISSING)
	{
		if (HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_MISSING))
			return vec3(1.0, 0.02, 0.02);
		if (HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_MISSING_TEXTURE))
			return vec3(1.0, 0.55, 0.02);
		if (!HasGPUMaterialFlag(flags, GPU_MATERIAL_FLAG_VALID))
			return vec3(1.0, 0.0, 1.0);
		return vec3(0.05, 0.80, 0.18);
	}

	return GPUSceneDebugColorFromID(materialID + 1u);
}

vec3 GetMaterialSceneDebugColor(uint objectIndex, uint mode)
{
	if (mode < GPU_MATERIAL_DEBUG_TEXTURE_VALIDITY)
		return GetGPUSceneDebugColor(objectIndex, mode);

	return GetMaterialSceneDebugColorForMaterialID(GetInstanceMaterialIndex(objectIndex), mode);
}

#endif // LUX_MATERIAL_SCENE_GLSLH
