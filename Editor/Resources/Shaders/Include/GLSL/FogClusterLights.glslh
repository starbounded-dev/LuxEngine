#ifndef LUX_FOG_CLUSTER_LIGHTS_GLSLH
#define LUX_FOG_CLUSTER_LIGHTS_GLSLH

// Per-sample local-light in-scattering for the volumetric height-fog march.
//
// This is the volumetric consumer of the froxel (clustered) light grid produced
// by ClusterLightCulling.glsl. For each ray-march sample we resolve its froxel
// (screen XY from gl_FragCoord, Z slice from view depth) and accumulate the
// in-scattered radiance of every point/spot light overlapping that froxel, phase
// weighted toward the camera. Spot lights are shadow-sampled against the spot
// atlas; the engine has no point-light shadow maps, so points are unshadowed.
//
// Kept deliberately self-contained (does not pull in the PBR surface stack) so
// the fog shader only binds what it needs: the cluster lists (set 1, 22-25), the
// point/spot light UBOs (already bound for surface shading) and the spot atlas.

#include <Cluster.glslh>
#include <Samplers.glslh>

// Clustered (froxel) light lists, produced by ClusterLightCulling.glsl. Same
// (set, binding) slots — and the same block names — the surface lighting consumes
// in Lighting.glslh, so SceneRenderer's PassInputLights binding (which keys off
// the block name) feeds this pass the exact same buffers.
layout(std430, set = 1, binding = 22) readonly buffer PointLightGridBuffer
{
	uvec2 Grid[]; // (offset, count)
} s_FogPointLightGrid;

layout(std430, set = 1, binding = 23) readonly buffer SpotLightGridBuffer
{
	uvec2 Grid[];
} s_FogSpotLightGrid;

layout(std430, set = 1, binding = 24) readonly buffer PointLightIndexListBuffer
{
	uint Indices[];
} s_FogPointLightIndexList;

layout(std430, set = 1, binding = 25) readonly buffer SpotLightIndexListBuffer
{
	uint Indices[];
} s_FogSpotLightIndexList;

const float LUX_FOG_SPOT_SHADOW_BIAS = 0.00035;

// Resolve the froxel for an arbitrary world-space march sample. The screen XY
// comes from the pixel being shaded (the whole ray shares it); only the Z slice
// varies along the ray.
uint FogResolveCluster(vec3 samplePosition, vec2 fragCoord)
{
	float linearDepth = -(u_Camera.ViewMatrix * vec4(samplePosition, 1.0)).z;
	uint zSlice = ClusterZSlice(linearDepth, u_RendererData.ClusterZParams.x, u_RendererData.ClusterZParams.y);

	vec2 clusterPx = u_ScreenData.FullResolution / vec2(float(CLUSTER_GRID_X), float(CLUSTER_GRID_Y));
	uvec2 xy = uvec2(clamp(fragCoord / clusterPx,
		vec2(0.0), vec2(float(CLUSTER_GRID_X - 1), float(CLUSTER_GRID_Y - 1))));

	return ClusterFlatten(uvec3(xy, zSlice));
}

// The includer (AtmosphericFog.glsl) must declare the spot shadow atlas before
// including this header so the march hook can stay texture-free at its call site
// inside Atmosphere.glslh.
//   layout(set = 1, binding = 3) uniform texture2D u_SpotShadowTexture;

// Hard single-tap spot-shadow visibility for a fog sample. One tap is plenty for
// volumetrics (up to 96 samples/ray), where soft PCSS would be far too costly.
float FogSampleSpotShadow(SpotLight light, vec3 samplePosition)
{
	if (!light.CastsShadows || light.ShadowIndex >= 16u || light.ShadowIndex >= u_SpotLightMatrices.Count)
		return 1.0;

	vec4 coords = u_SpotLightMatrices.Mats[light.ShadowIndex] * vec4(samplePosition, 1.0);
	if (coords.w <= 0.0)
		return 1.0;

	vec3 sc = coords.xyz / coords.w;
	// Flip Y to compensate for NVRHI viewport Y-axis inversion (matches ShadowMapping.glslh).
	vec2 localUV = vec2(sc.x * 0.5 + 0.5, -sc.y * 0.5 + 0.5);
	if (sc.z < 0.0 || sc.z > 1.0 || any(lessThan(localUV, vec2(0.0))) || any(greaterThan(localUV, vec2(1.0))))
		return 1.0;

	vec2 atlasUV = localUV * light.AtlasScale + vec2(light.AtlasOffsetX, light.AtlasOffsetY);
	float shadowMapDepth = SampleLinearLOD(u_SpotShadowTexture, atlasUV, 0).r;
	return step(sc.z - LUX_FOG_SPOT_SHADOW_BIAS, shadowMapDepth);
}

// Accumulated point + spot in-scattered radiance at a march sample. viewDirection
// points from the camera toward the sample; phaseG is the fog anisotropy.
vec3 EvaluateFogClusterLights(vec3 samplePosition, vec3 viewDirection, vec2 fragCoord)
{
	uint cluster = FogResolveCluster(samplePosition, fragCoord);
	float phaseG = clamp(u_Atmosphere.FogParams1.z, -0.95, 0.95);

	vec3 inscatter = vec3(0.0);

	// Point lights (unshadowed — no point-light shadow maps in the engine).
	uvec2 pointRange = s_FogPointLightGrid.Grid[cluster];
	pointRange.x = min(pointRange.x, CLUSTER_MAX_POINT_INDICES);
	pointRange.y = (u_PointLights.LightCount > 0u && pointRange.x < CLUSTER_MAX_POINT_INDICES)
		? min(pointRange.y, CLUSTER_MAX_POINT_INDICES - pointRange.x)
		: 0u;
	for (uint i = 0u; i < pointRange.y; ++i)
	{
		uint lightIndex = s_FogPointLightIndexList.Indices[pointRange.x + i];
		if (lightIndex >= u_PointLights.LightCount)
			continue;
		PointLight light = u_PointLights.Lights[lightIndex];

		vec3 toLight = light.Position - samplePosition;
		float dist = length(toLight);
		if (dist >= light.Radius)
			continue;
		vec3 Ldir = toLight / max(dist, 1e-4);

		float attenuation = clamp(1.0 - (dist * dist) / (light.Radius * light.Radius), 0.0, 1.0);
		attenuation *= mix(attenuation, 1.0, light.Falloff);

		float phase = CornetteShanksMiePhase(dot(viewDirection, Ldir), phaseG);
		inscatter += light.Radiance * light.Multiplier * attenuation * phase;
	}

	// Spot lights (shadow-sampled against the spot atlas).
	uvec2 spotRange = s_FogSpotLightGrid.Grid[cluster];
	spotRange.x = min(spotRange.x, CLUSTER_MAX_SPOT_INDICES);
	spotRange.y = (u_SpotLights.LightCount > 0u && spotRange.x < CLUSTER_MAX_SPOT_INDICES)
		? min(spotRange.y, CLUSTER_MAX_SPOT_INDICES - spotRange.x)
		: 0u;
	for (uint i = 0u; i < spotRange.y; ++i)
	{
		uint lightIndex = s_FogSpotLightIndexList.Indices[spotRange.x + i];
		if (lightIndex >= u_SpotLights.LightCount)
			continue;
		SpotLight light = u_SpotLights.Lights[lightIndex];

		vec3 toLight = light.Position - samplePosition;
		float dist = length(toLight);
		if (dist >= light.Range)
			continue;
		vec3 Ldir = toLight / max(dist, 1e-4);

		float cutoff = cos(radians(light.Angle * 0.5));
		float scos = dot(-Ldir, normalize(light.Direction));
		if (scos < cutoff)
			continue;
		float rim = (1.0 - scos) / max(1.0 - cutoff, 1e-4);

		float attenuation = clamp(1.0 - (dist * dist) / (light.Range * light.Range), 0.0, 1.0);
		attenuation *= mix(attenuation, 1.0, light.Falloff);
		attenuation *= 1.0 - pow(clamp(rim, 0.001, 1.0), light.AngleAttenuation);
		if (attenuation <= 0.0)
			continue;

		attenuation *= FogSampleSpotShadow(light, samplePosition);

		float phase = CornetteShanksMiePhase(dot(viewDirection, Ldir), phaseG);
		inscatter += light.Radiance * light.Multiplier * attenuation * phase;
	}

	return inscatter;
}

#endif // LUX_FOG_CLUSTER_LIGHTS_GLSLH
