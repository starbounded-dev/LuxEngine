#ifndef LUX_CLOUD_NOISE_GLSLH
#define LUX_CLOUD_NOISE_GLSLH

// ============================================================================
// Tileable 3D noise generators used to bake the volumetric-cloud noise volumes.
//
// Based on the Perlin-Worley construction described in Andrew Schneider's
// "Nubis: Authoring Realtime Volumetric Cloudscapes with the Decima Engine"
// (GDC / Siggraph). All generators are periodic so the resulting 3D textures
// tile seamlessly when sampled with a repeat sampler.
//
// Only included by the bake compute shaders, never by the raymarcher.
// ============================================================================

const float CLOUD_NOISE_PI = 3.14159265359;

// Periodic integer hash -> [0,1)^3. Wrapping the lattice coordinate by the
// frequency before hashing is what makes every generator below tileable.
vec3 CloudHash33(vec3 p)
{
	p = mod(p, 289.0);
	p = vec3(
		dot(p, vec3(127.1, 311.7, 74.7)),
		dot(p, vec3(269.5, 183.3, 246.1)),
		dot(p, vec3(113.5, 271.9, 124.6)));
	return fract(sin(p) * 43758.5453123);
}

// Tileable Worley (cellular) noise. Returns the inverted nearest-feature
// distance in [0,1] (1 = cell centre, 0 = cell border) which reads as billowy
// cloud lobes. 'freq' is the number of cells per axis and must be integer to
// tile across [0,1).
float CloudWorley(vec3 uvw, float freq)
{
	vec3 p = uvw * freq;
	vec3 cell = floor(p);
	vec3 local = fract(p);

	float minDistSq = 1.0e9;
	for (int z = -1; z <= 1; ++z)
	{
		for (int y = -1; y <= 1; ++y)
		{
			for (int x = -1; x <= 1; ++x)
			{
				vec3 offset = vec3(float(x), float(y), float(z));
				vec3 neighbour = cell + offset;
				vec3 wrapped = mod(neighbour, freq); // periodic wrap
				vec3 feature = offset + CloudHash33(wrapped) - local;
				minDistSq = min(minDistSq, dot(feature, feature));
			}
		}
	}

	return 1.0 - clamp(sqrt(minDistSq), 0.0, 1.0);
}

// Multi-octave Worley used both for the base-shape low band and the detail
// volume. Octaves double in frequency and halve in amplitude.
float CloudWorleyFBM(vec3 uvw, float freq)
{
	return CloudWorley(uvw, freq) * 0.625
		+ CloudWorley(uvw, freq * 2.0) * 0.25
		+ CloudWorley(uvw, freq * 4.0) * 0.125;
}

// Periodic gradient (Perlin) noise. Gradients are derived from the same
// periodic hash so the field tiles across [0,1).
float CloudPerlin(vec3 uvw, float freq)
{
	vec3 p = uvw * freq;
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0); // quintic fade

	float n = 0.0;
	for (int z = 0; z <= 1; ++z)
	{
		for (int y = 0; y <= 1; ++y)
		{
			for (int x = 0; x <= 1; ++x)
			{
				vec3 corner = vec3(float(x), float(y), float(z));
				vec3 wrapped = mod(i + corner, freq);
				vec3 grad = normalize(CloudHash33(wrapped) * 2.0 - 1.0);
				vec3 diff = f - corner;
				float dotVal = dot(grad, diff);

				vec3 w = mix(1.0 - u, u, corner);
				n += dotVal * w.x * w.y * w.z;
			}
		}
	}

	return n;
}

// Billowy multi-octave Perlin remapped to [0,1].
float CloudPerlinFBM(vec3 uvw, float freq)
{
	float total = 0.0;
	float amplitude = 0.5;
	float f = freq;
	for (int i = 0; i < 4; ++i)
	{
		total += CloudPerlin(uvw, f) * amplitude;
		f *= 2.0;
		amplitude *= 0.5;
	}
	// Map signed Perlin into [0,1].
	return clamp(total * 0.5 + 0.5, 0.0, 1.0);
}

float CloudRemap(float value, float oldMin, float oldMax, float newMin, float newMax)
{
	return newMin + (clamp(value, oldMin, oldMax) - oldMin) / max(oldMax - oldMin, 1.0e-5) * (newMax - newMin);
}

// Schneider's Perlin-Worley: a billowy Perlin field whose low end is lifted by
// a Worley field, giving connected cloud masses with eroded undersides.
float CloudPerlinWorley(vec3 uvw, float perlinFreq, float worleyFreq)
{
	float perlin = CloudPerlinFBM(uvw, perlinFreq);
	float worley = CloudWorleyFBM(uvw, worleyFreq);
	return clamp(CloudRemap(perlin, worley - 1.0, 1.0, 0.0, 1.0), 0.0, 1.0);
}

// Three decorrelated periodic Perlin fields forming a vector potential.
vec3 CloudCurlPotential(vec3 uvw, float freq)
{
	return vec3(
		CloudPerlin(uvw, freq),
		CloudPerlin(uvw + vec3(31.3, 17.7, 5.1), freq),
		CloudPerlin(uvw + vec3(11.9, 47.3, 23.1), freq));
}

// Tileable curl noise: curl of the potential above, giving a divergence-free
// (swirling, turbulent) vector field used to advect the cloud detail erosion so
// cloud bases get wispy, twisting tendrils (Nubis / Decima look).
vec3 CloudCurlNoise(vec3 uvw, float freq)
{
	const float e = 1.0 / 128.0;
	vec3 dx = vec3(e, 0.0, 0.0);
	vec3 dy = vec3(0.0, e, 0.0);
	vec3 dz = vec3(0.0, 0.0, e);

	vec3 px0 = CloudCurlPotential(uvw - dx, freq);
	vec3 px1 = CloudCurlPotential(uvw + dx, freq);
	vec3 py0 = CloudCurlPotential(uvw - dy, freq);
	vec3 py1 = CloudCurlPotential(uvw + dy, freq);
	vec3 pz0 = CloudCurlPotential(uvw - dz, freq);
	vec3 pz1 = CloudCurlPotential(uvw + dz, freq);

	float x = (py1.z - py0.z) - (pz1.y - pz0.y);
	float y = (pz1.x - pz0.x) - (px1.z - px0.z);
	float z = (px1.y - px0.y) - (py1.x - py0.x);

	return normalize(vec3(x, y, z) + vec3(1.0e-6));
}

#endif // LUX_CLOUD_NOISE_GLSLH
