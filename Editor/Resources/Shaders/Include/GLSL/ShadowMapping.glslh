#ifndef LUX_SHADOW_MAPPING_GLSLH
#define LUX_SHADOW_MAPPING_GLSLH

#if defined(__FRAGMENT_STAGE__) || defined(__COMPUTE_STAGE__)
#include <Buffers.glslh>
#include <Lighting.glslh>
#include <Samplers.glslh>

// Depth-comparison sampler (Renderer::GetShadowSampler): a shadow-map read returns the lit fraction
// of a 2x2 bilinear footprint, reference <= stored depth, so every tap is hardware PCF.
layout(set = 3, binding = 8) uniform sampler r_ShadowSampler;

/////////////////////////////////////////////
// PCSS
/////////////////////////////////////////////

float ShadowFade = 1.0; //TODO(Karim): A better placement of this?

const uint LUX_SHADOW_FILTER_TUNED_PCF = 0u;
const uint LUX_SHADOW_FILTER_PCSS = 1u;
const uint LUX_SHADOW_FILTER_HYBRID = 2u;

uint ClampDirectionalCascade(uint cascade)
{
	uint activeCascadeCount = clamp(u_RendererData.ActiveShadowCascadeCount, 1u, 4u);
	return min(cascade, activeCascadeCount - 1u);
}

vec3 GetShadowMapCoords(vec3 shadowMapCoords[4], uint cascade)
{
	// NOTE(Yan): this exists because AMD doesn't seem to like indexing of varyings (causes artifacts)
	switch (cascade)
	{
		case 0: return shadowMapCoords[0];
		case 1: return shadowMapCoords[1];
		case 2: return shadowMapCoords[2];
		case 3: return shadowMapCoords[3];
	}
	return vec3(0.0f);
}

float GetDirShadowBias()
{
	const float MINIMUM_SHADOW_BIAS = 0.002;
	float bias = max(MINIMUM_SHADOW_BIAS * (1.0 - dot(m_Params.Normal, u_Scene.DirectionalLights.Direction)), MINIMUM_SHADOW_BIAS);
	return bias;
}

// Convert shadow coords from clip space [-1,1] to UV space [0,1]
// Flips Y to compensate for NVRHI viewport Y-axis inversion
vec2 ShadowCoordsToUV(vec2 shadowCoords)
{
	return vec2(shadowCoords.x * 0.5 + 0.5, -shadowCoords.y * 0.5 + 0.5);
}

bool IsDirectionalShadowSampleValid(vec3 shadowCoords, vec2 uv)
{
	return shadowCoords.z >= 0.0 && shadowCoords.z <= 1.0
		&& all(greaterThanEqual(uv, vec2(0.0)))
		&& all(lessThanEqual(uv, vec2(1.0)));
}

float DirectionalShadowMapEdgeFade(vec2 uv)
{
	vec2 edgeDistance = min(uv, vec2(1.0) - uv);
	return smoothstep(0.0, 0.025, min(edgeDistance.x, edgeDistance.y));
}

float ApplyDirectionalShadowFades(float shadowVisibility, vec2 uv)
{
	return mix(1.0, shadowVisibility, ShadowFade * DirectionalShadowMapEdgeFade(uv));
}

float SampleDirectionalShadowVisibility(texture2DArray shadowMap, uint cascade, vec3 shadowCoords, vec2 uv, float bias)
{
	if (!IsDirectionalShadowSampleValid(shadowCoords, uv))
		return 1.0;

	cascade = ClampDirectionalCascade(cascade);
	return texture(sampler2DArrayShadow(shadowMap, r_ShadowSampler), vec4(uv, float(cascade), shadowCoords.z - bias));
}

float HardShadows_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords)
{
	cascade = ClampDirectionalCascade(cascade);
	float bias = GetDirShadowBias();
	vec2 uv = ShadowCoordsToUV(shadowCoords.xy);
	float visibility = SampleDirectionalShadowVisibility(shadowMap, cascade, shadowCoords, uv, bias);
	return ApplyDirectionalShadowFades(visibility, uv);
}

// Penumbra
// this search area estimation comes from the following article: 
// http://developer.download.nvidia.com/whitepapers/2008/PCSS_Integration.pdf
float SearchWidth(float uvLightSize, float receiverDistance)
{
	const float NEAR = 0.1;
	return uvLightSize * (receiverDistance - NEAR) / u_Scene.CameraPosition.z;
}

float SearchRegionRadiusUV(float zWorld)
{
	const float light_zNear = 0.0; // 0.01 gives artifacts? maybe because of ortho proj?
	const float lightRadiusUV = 0.05;
	return lightRadiusUV * (zWorld - light_zNear) / zWorld;
}

const vec2 poissonDisk[16] = vec2[](
	vec2(-0.94201624, -0.39906216),
	vec2(0.94558609, -0.76890725),
	vec2(-0.094184101, -0.92938870),
	vec2(0.34495938, 0.29387760),
	vec2(-0.91588581, 0.45771432),
	vec2(-0.81544232, -0.87912464),
	vec2(-0.38277543, 0.27676845),
	vec2(0.97484398, 0.75648379),
	vec2(0.44323325, -0.97511554),
	vec2(0.53742981, -0.47373420),
	vec2(-0.26496911, -0.41893023),
	vec2(0.79197514, 0.19090188),
	vec2(-0.24188840, 0.99706507),
	vec2(-0.81409955, 0.91437590),
	vec2(0.19984126, 0.78641367),
	vec2(0.14383161, -0.14100790)
	);

// PCSS taps come from RendererData.ShadowKernel (SceneRenderer::BuildShadowKernel): unit-disk offsets
// whose counts follow the shadow quality tier.
uint GetShadowBlockerSampleCount()
{
	return clamp(u_RendererData.ShadowBlockerSampleCount, 1u, uint(SHADOW_KERNEL_SIZE));
}

uint GetShadowFilterSampleCount()
{
	return clamp(u_RendererData.ShadowFilterSampleCount, 1u, uint(SHADOW_KERNEL_SIZE));
}

vec2 ShadowFilterTap(uint index)
{
	return u_RendererData.ShadowKernel[index].xy;
}

vec2 ShadowBlockerTap(uint index)
{
	return u_RendererData.ShadowKernel[index].zw;
}

// A PCSS blocker search. AverageDepth is negative when no tap is occluded. AllOccluded means every
// valid tap is: the filter footprint never exceeds the search footprint, so the receiver is fully
// shadowed and the filter pass is skipped.
struct ShadowBlockerSearch
{
	float AverageDepth;
	bool AllOccluded;
};

/////////////////////////////////////////////
// Directional Shadows
/////////////////////////////////////////////

ShadowBlockerSearch FindBlockers_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords)
{
	cascade = ClampDirectionalCascade(cascade);
	float bias = GetDirShadowBias();

	ShadowBlockerSearch result = ShadowBlockerSearch(-1.0, false);
	vec2 uv = ShadowCoordsToUV(shadowCoords.xy);
	if (!IsDirectionalShadowSampleValid(shadowCoords, uv))
		return result;

	uint sampleCount = GetShadowBlockerSampleCount();
	uint validSamples = 0u;
	uint blockers = 0u;
	float blockerDepthSum = 0.0;
	float searchWidth = SearchRegionRadiusUV(shadowCoords.z);
	for (uint i = 0u; i < sampleCount; i++)
	{
		vec2 sampleUV = uv + ShadowBlockerTap(i) * searchWidth;
		if (!IsDirectionalShadowSampleValid(shadowCoords, sampleUV))
			continue;

		validSamples++;
		float z = SampleLinearLOD(shadowMap, vec3(sampleUV, cascade), 0).r;
		if (z < (shadowCoords.z - bias))
		{
			blockers++;
			blockerDepthSum += z;
		}
	}

	if (blockers > 0u)
	{
		result.AverageDepth = blockerDepthSum / float(blockers);
		result.AllOccluded = blockers == validSamples;
	}
	return result;
}

float PCF_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords, float uvRadius)
{
	cascade = ClampDirectionalCascade(cascade);
	float bias = GetDirShadowBias();
	vec2 uv = ShadowCoordsToUV(shadowCoords.xy);
	if (!IsDirectionalShadowSampleValid(shadowCoords, uv))
		return 1.0;

	uint sampleCount = GetShadowFilterSampleCount();
	float sum = 0.0;
	for (uint i = 0u; i < sampleCount; i++)
		sum += SampleDirectionalShadowVisibility(shadowMap, cascade, shadowCoords, uv + ShadowFilterTap(i) * uvRadius, bias);
	return ApplyDirectionalShadowFades(sum / float(sampleCount), uv);
}

float NV_PCF_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords, float uvRadius)
{
	cascade = ClampDirectionalCascade(cascade);
	float bias = GetDirShadowBias();
	vec2 uv = ShadowCoordsToUV(shadowCoords.xy);
	if (!IsDirectionalShadowSampleValid(shadowCoords, uv))
		return 1.0;

	float sum = 0;
	for (int i = 0; i < 16; i++)
	{
		vec2 offset = poissonDisk[i] * uvRadius;
		sum += SampleDirectionalShadowVisibility(shadowMap, cascade, shadowCoords, uv + offset, bias);
	}
	return ApplyDirectionalShadowFades(sum / 16.0f, uv);
}

float TunedPCF_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords)
{
	cascade = ClampDirectionalCascade(cascade);
	float bias = GetDirShadowBias();
	vec2 uv = ShadowCoordsToUV(shadowCoords.xy);
	if (!IsDirectionalShadowSampleValid(shadowCoords, uv))
		return 1.0;

	ivec3 shadowMapSize = textureSize(sampler2DArray(shadowMap, r_LinearSampler), 0);
	float texelRadius = u_RendererData.ShadowFilterParams.x * mix(1.0, 1.75, clamp(float(cascade) / 3.0, 0.0, 1.0));
	float uvRadius = texelRadius / max(float(shadowMapSize.x), 1.0);

	float sum = SampleDirectionalShadowVisibility(shadowMap, cascade, shadowCoords, uv, bias) * 2.0;
	for (int i = 0; i < 16; i++)
	{
		vec2 offset = poissonDisk[i] * uvRadius;
		sum += SampleDirectionalShadowVisibility(shadowMap, cascade, shadowCoords, uv + offset, bias);
	}

	return ApplyDirectionalShadowFades(sum / 18.0, uv);
}

float RawPCSS_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords, float uvLightSize)
{
	cascade = ClampDirectionalCascade(cascade);
	ShadowBlockerSearch blockers = FindBlockers_DirectionalLight(shadowMap, cascade, shadowCoords);
	if (blockers.AverageDepth < 0.0) // No occlusion
		return 1.0f;
	if (blockers.AllOccluded)
		return ApplyDirectionalShadowFades(0.0, ShadowCoordsToUV(shadowCoords.xy));

	float blockerDistance = blockers.AverageDepth;
	float penumbraWidth = (shadowCoords.z - blockerDistance) / blockerDistance;

	float NEAR = 0.01; // Should this value be tweakable?
	float uvRadius = penumbraWidth * uvLightSize * NEAR / max(shadowCoords.z, 0.001f); // Do we need to divide by shadowCoords.z?
	uvRadius = min(uvRadius, 0.002f);
	return PCF_DirectionalLight(shadowMap, cascade, shadowCoords, uvRadius);
}

float PCSS_DirectionalLight(texture2DArray shadowMap, uint cascade, vec3 shadowCoords, float uvLightSize)
{
	cascade = ClampDirectionalCascade(cascade);
	if (u_RendererData.ShadowFilterMode == LUX_SHADOW_FILTER_PCSS)
		return RawPCSS_DirectionalLight(shadowMap, cascade, shadowCoords, uvLightSize);

	if (u_RendererData.ShadowFilterMode == LUX_SHADOW_FILTER_HYBRID && cascade < u_RendererData.DirectionalPCSSCascadeCount)
		return RawPCSS_DirectionalLight(shadowMap, cascade, shadowCoords, uvLightSize);

	return TunedPCF_DirectionalLight(shadowMap, cascade, shadowCoords);
}

/////////////////////////////////////////////
// Spot light Shadows (with dynamic atlas support)
// Supports up to 16 spotlights with grids: 1x1, 2x2, 3x3, 4x4
/////////////////////////////////////////////

const float SPOT_SHADOW_BIAS = 0.00025f;

bool IsSpotShadowSampleValid(vec3 shadowCoords, vec2 localUV)
{
	return shadowCoords.z >= 0.0 && shadowCoords.z <= 1.0
		&& all(greaterThanEqual(localUV, vec2(0.0)))
		&& all(lessThanEqual(localUV, vec2(1.0)));
}

float SpotShadowMapEdgeFade(vec2 localUV)
{
	vec2 edgeDistance = min(localUV, vec2(1.0) - localUV);
	return smoothstep(0.0, 0.025, min(edgeDistance.x, edgeDistance.y));
}

float ApplySpotShadowFades(float shadowVisibility, vec2 localUV)
{
	return mix(1.0, shadowVisibility, SpotShadowMapEdgeFade(localUV));
}

float SampleSpotShadowVisibility(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords, vec2 localUV)
{
	if (!IsSpotShadowSampleValid(shadowCoords, localUV))
		return 1.0;

	vec2 atlasUV = localUV * atlasScale + atlasOffset;
	return texture(sampler2DShadow(shadowMap, r_ShadowSampler), vec3(atlasUV, shadowCoords.z - SPOT_SHADOW_BIAS));
}

float HardShadows_SpotLight(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords)
{
	float visibility = SampleSpotShadowVisibility(shadowMap, atlasOffset, atlasScale, shadowCoords, shadowCoords.xy);
	return ApplySpotShadowFades(visibility, shadowCoords.xy);
}

// A spot tile or point-light face is a perspective projection with depth in [0, 1], stored as P * V
// with V rigid. So clip.w is the linear depth along the light's axis, and clip.z = -A * clip.w + B:
// a stored depth d linearizes as B / (d + A). Row 0 has length P[0][0], so a lateral metre at linear
// depth w spans 0.5 * P[0][0] / w of the tile.
struct SpotShadowProjection
{
	float DepthA;
	float DepthB;
	float UVPerMetre; // tile UV per lateral metre at unit depth
};

SpotShadowProjection GetSpotShadowProjection(mat4 viewProjection)
{
	vec3 row0 = vec3(viewProjection[0][0], viewProjection[1][0], viewProjection[2][0]);
	vec4 row2 = vec4(viewProjection[0][2], viewProjection[1][2], viewProjection[2][2], viewProjection[3][2]);
	vec4 row3 = vec4(viewProjection[0][3], viewProjection[1][3], viewProjection[2][3], viewProjection[3][3]);

	SpotShadowProjection projection;
	projection.DepthA = -dot(row2.xyz, row3.xyz) / max(dot(row3.xyz, row3.xyz), 1e-12);
	projection.DepthB = row2.w + projection.DepthA * row3.w;
	projection.UVPerMetre = 0.5 * length(row0);
	return projection;
}

float LinearizeSpotShadowDepth(SpotShadowProjection projection, float deviceDepth)
{
	return projection.DepthB / (deviceDepth + projection.DepthA);
}

// The widest blocker search, in tile UV. Point-light faces keep a 5% margin to their tile edge, so a
// search no wider than that never reads a neighbouring tile.
const float SPOT_PCSS_MAX_SEARCH_UV = 0.05;

float PCF_SpotLight(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords, float localRadius)
{
	if (!IsSpotShadowSampleValid(shadowCoords, shadowCoords.xy))
		return 1.0;

	uint sampleCount = GetShadowFilterSampleCount();
	float sum = 0.0;
	for (uint i = 0u; i < sampleCount; i++)
		sum += SampleSpotShadowVisibility(shadowMap, atlasOffset, atlasScale, shadowCoords, shadowCoords.xy + ShadowFilterTap(i) * localRadius);
	return ApplySpotShadowFades(sum / float(sampleCount), shadowCoords.xy);
}


float TunedPCF_SpotLight(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords)
{
	if (!IsSpotShadowSampleValid(shadowCoords, shadowCoords.xy))
		return 1.0;

	ivec2 atlasSize = textureSize(sampler2D(shadowMap, r_LinearSampler), 0);
	float localRadius = u_RendererData.ShadowFilterParams.y / max(float(atlasSize.x) * max(atlasScale, 0.001), 1.0);

	float sum = SampleSpotShadowVisibility(shadowMap, atlasOffset, atlasScale, shadowCoords, shadowCoords.xy) * 2.0;
	for (int i = 0; i < 16; i++)
	{
		vec2 sampleUV = shadowCoords.xy + poissonDisk[i] * localRadius;
		sum += SampleSpotShadowVisibility(shadowMap, atlasOffset, atlasScale, shadowCoords, sampleUV);
	}

	return ApplySpotShadowFades(sum / 18.0, shadowCoords.xy);
}

// receiverDepth is the receiver's clip.w in the tile (its linear depth), lightSize the emitter
// diameter in metres. Radii are in the tile's local UV.
float RawPCSS_SpotLight(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords, float receiverDepth, uint tile, float lightSize)
{
	if (!IsSpotShadowSampleValid(shadowCoords, shadowCoords.xy))
		return 1.0;

	SpotShadowProjection projection = GetSpotShadowProjection(u_SpotLightMatrices.Mats[tile]);
	float lightRadius = 0.5 * max(lightSize, 0.0);
	float nearPlane = projection.DepthB / projection.DepthA;
	float texelUV = 1.0 / max(float(textureSize(sampler2D(shadowMap, r_LinearSampler), 0).x) * atlasScale, 1.0);

	// An occluder at depth z between the receiver and the emitter sits within
	// lightRadius * (receiverDepth - z) / receiverDepth metres of the receiver's ray, which projects
	// widest at the near plane.
	float searchRadius = lightRadius * projection.UVPerMetre * max(receiverDepth - nearPlane, 0.0) / max(receiverDepth * nearPlane, 1e-6);
	searchRadius = clamp(searchRadius, texelUV, SPOT_PCSS_MAX_SEARCH_UV);

	uint sampleCount = GetShadowBlockerSampleCount();
	uint validSamples = 0u;
	uint blockers = 0u;
	float blockerDepthSum = 0.0;
	for (uint i = 0u; i < sampleCount; i++)
	{
		vec2 sampleUV = shadowCoords.xy + ShadowBlockerTap(i) * searchRadius;
		if (!IsSpotShadowSampleValid(shadowCoords, sampleUV))
			continue;

		validSamples++;
		float z = SampleLinearLOD(shadowMap, sampleUV * atlasScale + atlasOffset, 0).r;
		if (z < (shadowCoords.z - SPOT_SHADOW_BIAS))
		{
			blockers++;
			blockerDepthSum += LinearizeSpotShadowDepth(projection, z);
		}
	}

	if (blockers == 0u)
		return 1.0;
	if (blockers == validSamples)
		return ApplySpotShadowFades(0.0, shadowCoords.xy);

	// Penumbra half-width at the receiver, lightRadius * (receiver - blocker) / blocker metres,
	// converted to tile UV at the receiver's depth. Capped by the search so the early-out stays exact.
	float blockerDepth = blockerDepthSum / float(blockers);
	float filterRadius = lightRadius * (receiverDepth - blockerDepth) / max(blockerDepth, 1e-4) * projection.UVPerMetre / max(receiverDepth, 1e-4);
	filterRadius = clamp(filterRadius, texelUV, searchRadius);
	return PCF_SpotLight(shadowMap, atlasOffset, atlasScale, shadowCoords, filterRadius);
}

float PCSS_SpotLight(texture2D shadowMap, vec2 atlasOffset, float atlasScale, vec3 shadowCoords, float receiverDepth, uint tile, float lightSize)
{
	if (u_RendererData.ShadowFilterMode == LUX_SHADOW_FILTER_PCSS)
		return RawPCSS_SpotLight(shadowMap, atlasOffset, atlasScale, shadowCoords, receiverDepth, tile, lightSize);

	return TunedPCF_SpotLight(shadowMap, atlasOffset, atlasScale, shadowCoords);
}

vec3 CalculateSpotLightsShadowed(in vec3 F0, vec3 worldPos, texture2D SpotAtlas)
{
	SetupClusterLights(worldPos);
	vec3 result = vec3(0.0);
	for (int i = 0; i < GetSpotLightCount(); i++)
	{
		int visibleIndex = GetSpotLightBufferIndex(i);
		if (visibleIndex < 0)
			break;

		uint lightIndex = uint(visibleIndex);

		SpotLight light = u_SpotLights.Lights[lightIndex];
		vec3 toLight = light.Position - worldPos;
		float distanceSq = dot(toLight, toLight);
		vec3 Li = toLight * inversesqrt(max(distanceSq, 1e-12));

		float cutoff = cos(radians(light.Angle * 0.5f));
		float scos = max(dot(-Li, normalize(light.Direction)), cutoff);
		float rim = (1.0 - scos) / (1.0 - cutoff);

		float attenuation = LuxPunctualLightAttenuation(distanceSq, light.Range);
		attenuation *= 1.0 - pow(max(rim, 0.001), light.AngleAttenuation);

		// Shadow sampling - supports up to 16 spotlights with dynamic atlas
		if(light.CastsShadows && light.ShadowIndex < SHADOW_ATLAS_MAX_TILES && light.ShadowIndex < u_SpotLightMatrices.Count)
		{
			vec4 coords = u_SpotLightMatrices.Mats[light.ShadowIndex] * vec4(worldPos, 1.0f);
			if (coords.w <= 0.0f)
				continue;

			vec3 shadowMapCoords = (coords.xyz / coords.w);
			// Flip Y to compensate for NVRHI viewport Y-axis inversion
			shadowMapCoords.xy = ShadowCoordsToUV(shadowMapCoords.xy);

			bool outsideShadowmap = any(lessThan(shadowMapCoords.xyz, vec3(0.0f))) || any(greaterThan(shadowMapCoords.xyz, vec3(1.0f)));

			if (!outsideShadowmap)
			{
				// Get atlas offset and scale from light struct
				vec2 atlasOffset = vec2(light.AtlasOffsetX, light.AtlasOffsetY);
				float atlasScale = light.AtlasScale;
				attenuation *= light.SoftShadows
					? PCSS_SpotLight(SpotAtlas, atlasOffset, atlasScale, shadowMapCoords, coords.w, light.ShadowIndex, light.LightSize)
					: HardShadows_SpotLight(SpotAtlas, atlasOffset, atlasScale, shadowMapCoords);
			}
		}

		vec3 Lradiance = light.Radiance * light.Multiplier * attenuation;
		result += LuxEvaluateDirectBRDF(F0, m_Params.Albedo, m_Params.Metalness, m_Params.Roughness, m_Params.Normal, m_Params.View, Li) * Lradiance;

	}
	return result;
}

/////////////////////////////////////////////
// Point light shadows: six spot-atlas tiles per light, one per cube face (+X, -X, +Y, -Y, +Z, -Z).
// Each face is rendered with a FOV slightly wider than 90 degrees, so the face picked by the major
// axis always lands inside [0.05, 0.95] of its tile and filter taps never cross a cube seam.
/////////////////////////////////////////////

uint PointShadowFace(vec3 lightToFragment)
{
	vec3 a = abs(lightToFragment);
	if (a.x >= a.y && a.x >= a.z)
		return lightToFragment.x >= 0.0 ? 0u : 1u;
	if (a.y >= a.z)
		return lightToFragment.y >= 0.0 ? 2u : 3u;
	return lightToFragment.z >= 0.0 ? 4u : 5u;
}

float SamplePointLightShadow(PointLight light, vec3 worldPos, texture2D shadowAtlas)
{
	uint tile = light.ShadowIndex + PointShadowFace(worldPos - light.Position);
	if (tile >= SHADOW_ATLAS_MAX_TILES || tile >= u_SpotLightMatrices.Count)
		return 1.0;

	vec4 coords = u_SpotLightMatrices.Mats[tile] * vec4(worldPos, 1.0);
	if (coords.w <= 0.0)
		return 1.0;

	vec3 shadowMapCoords = coords.xyz / coords.w;
	shadowMapCoords.xy = ShadowCoordsToUV(shadowMapCoords.xy);

	uint gridSize = uint(round(1.0 / max(light.AtlasScale, 1e-4)));
	vec2 atlasOffset = vec2(float(tile % gridSize), float(tile / gridSize)) * light.AtlasScale;
	return (light.ShadowFlags & POINT_LIGHT_SHADOW_SOFT) != 0u
		? PCSS_SpotLight(shadowAtlas, atlasOffset, light.AtlasScale, shadowMapCoords, coords.w, tile, light.LightSize)
		: HardShadows_SpotLight(shadowAtlas, atlasOffset, light.AtlasScale, shadowMapCoords);
}

vec3 CalculatePointLightsShadowed(in vec3 F0, vec3 worldPos, texture2D shadowAtlas)
{
	SetupClusterLights(worldPos);
	vec3 result = vec3(0.0);
	for (int i = 0; i < GetPointLightCount(); i++)
	{
		int visibleIndex = GetPointLightBufferIndex(i);
		if (visibleIndex < 0)
			break;

		PointLight light = u_PointLights.Lights[uint(visibleIndex)];
		vec3 toLight = light.Position - worldPos;
		float distanceSq = dot(toLight, toLight);
		vec3 Li = toLight * inversesqrt(max(distanceSq, 1e-12));

		float attenuation = LuxPunctualLightAttenuation(distanceSq, light.Radius);
		if (attenuation > 0.0 && (light.ShadowFlags & POINT_LIGHT_SHADOW_CASTS) != 0u)
			attenuation *= SamplePointLightShadow(light, worldPos, shadowAtlas);

		vec3 Lradiance = light.Radiance * light.Multiplier * attenuation;
		result += LuxEvaluateDirectBRDF(F0, m_Params.Albedo, m_Params.Metalness, m_Params.Roughness, m_Params.Normal, m_Params.View, Li) * Lradiance;
	}
	return result;
}

#endif // defined(__FRAGMENT_STAGE) || defined(__COMPUTE_STAGE)

#endif // LUX_SHADOW_MAPPING_GLSLH
