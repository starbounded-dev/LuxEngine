//
// SET 2
//

layout(std140, set = 2, binding = 0) uniform Camera
{
	mat4 ViewProjectionMatrix;
	mat4 InverseViewProjectionMatrix;
	mat4 ProjectionMatrix;
	mat4 InverseProjectionMatrix;
	mat4 ViewMatrix;
	mat4 InverseViewMatrix;
	vec2 NDCToViewMul;
	vec2 NDCToViewAdd;
	vec2 DepthUnpackConsts;
	vec2 CameraTanHalfFOV;
	// TAA motion-vector support (see SceneRenderer UBCamera).
	mat4 UnjitteredViewProjectionMatrix;
	mat4 PreviousViewProjectionMatrix;
	vec2 Jitter;
	vec2 PreviousJitter;
	int IsOrthographic; // DepthUnpackConsts is then affine: depth = x * deviceDepth + y
} u_Camera;

// Positive view-space depth of a device depth value, for either projection.
float LinearizeDeviceDepth(float deviceDepth)
{
	vec2 unpack = u_Camera.DepthUnpackConsts;
	if (u_Camera.IsOrthographic != 0)
		return unpack.x * deviceDepth + unpack.y;
	return unpack.x / (unpack.y - deviceDepth);
}

// Unit vector from a surface toward the viewer. An orthographic camera views along one axis, so
// every surface sees it from the camera's backward axis rather than from its position.
vec3 GetViewDirection(vec3 worldPosition)
{
	if (u_Camera.IsOrthographic != 0)
		return normalize(u_Camera.InverseViewMatrix[2].xyz);
	return normalize(u_Scene.CameraPosition - worldPosition);
}

// Entries in RendererData.ShadowKernel. Mirrors SceneRenderer::ShadowKernelSize.
#define SHADOW_KERNEL_SIZE 32

layout(std140, set = 2, binding = 1) uniform RendererData
{
	uniform vec4 CascadeSplits;
	uniform int TilesCountX;
	uniform bool ShowCascades;
	uniform bool SoftShadows;
	uniform float LightSize;
	uniform float MaxShadowDistance;
	uniform float ShadowFade;
	uniform bool CascadeFading;
	uniform float CascadeTransitionFade;
	uniform bool ShowLightComplexity;
	uniform bool ShowMaterialComplexity;
	uniform float TextureMipBias;
	uniform bool EnableDistanceMipBias;
	uniform float DistanceMipBiasStart;
	uniform float DistanceMipBiasEnd;
	uniform float DistanceMipBiasMax;
	uniform uint GPUSceneDebugMode;
	uniform vec4 ClusterZParams; // x = zNear, y = zFar (clustered light culling)
	uniform uint ActiveShadowCascadeCount;
	uniform uint ShadowFilterMode;
	uniform uint DirectionalPCSSCascadeCount;
	uniform uint ShadowBlockerSampleCount; // PCSS blocker-search taps, 1..SHADOW_KERNEL_SIZE
	uniform vec4 ShadowFilterParams; // x = directional PCF radius in texels, y = spot PCF radius in texels
	uniform uint ShadowFilterSampleCount;  // PCSS filter taps, 1..SHADOW_KERNEL_SIZE
	uniform float Time; // seconds since the application started, for material graphs
	uniform uint ShadowKernelPadding1;
	uniform uint ShadowKernelPadding2;
	// Unit-disk sample offsets built on the CPU: xy = filter tap i of ShadowFilterSampleCount,
	// zw = blocker-search tap i of ShadowBlockerSampleCount. Each set is a Vogel disk over its own count.
	uniform vec4 ShadowKernel[SHADOW_KERNEL_SIZE];
} u_RendererData;

layout(std140, set = 2, binding = 2) uniform ScreenData
{
    vec2 InvFullResolution;
    vec2 FullResolution;
	vec2 InvHalfResolution;
    vec2 HalfResolution;
	vec2 InvQuarterResolution;
    vec2 QuarterResolution;
} u_ScreenData;

