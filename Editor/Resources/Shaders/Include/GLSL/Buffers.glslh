#ifndef LUX_BUFFERS_GLSLH
#define LUX_BUFFERS_GLSLH

//
// SET 1
//

layout (std140, set = 1, binding = 4) uniform ShadowData 
{
	mat4 DirLightMatrices[4];
} u_DirShadow;

struct DirectionalLight
{
	vec3 Direction;
	float ShadowAmount;
	vec3 Radiance;  
	float Multiplier;
};

layout(std140, set = 1, binding = 5) uniform SceneData
{
	DirectionalLight DirectionalLights;
	vec3 CameraPosition; // Offset = 32
	float EnvironmentMapIntensity;
	float EnvironmentMapRotation; // degrees about +Y (the sky light's rotation)
} u_Scene;


struct PointLight
{
	vec3 Position;
	float Multiplier;
	vec3 Radiance;
	uint ShadowIndex;  // first of six spot-atlas tiles, one per cube face (+X, -X, +Y, -Y, +Z, -Z)
	float Radius;      // range: the falloff window reaches zero here
	float AtlasScale;  // atlas tile size in UV (1 / grid size)
	float LightSize;
	uint ShadowFlags;  // POINT_LIGHT_SHADOW_*
};

const uint POINT_LIGHT_SHADOW_CASTS = 1u;
const uint POINT_LIGHT_SHADOW_SOFT = 2u;

layout(std140, set = 1, binding = 6) uniform PointLightData
{
	uint LightCount;
	PointLight Lights[1000];
} u_PointLights;

struct SpotLight
{
	vec3 Position;
	float Multiplier;
	vec3 Direction;
	float AngleAttenuation;
	vec3 Radiance;
	float Range;
	float Angle;
	float LightSize;     // emitter diameter in metres, sets the PCSS penumbra (SpotLightComponent::Falloff)
	uint ShadowIndex;
	bool SoftShadows;
	bool CastsShadows;	
	float AtlasOffsetX;  // Shadow atlas quadrant offset X 
	float AtlasOffsetY;  // Shadow atlas quadrant offset Y 
	float AtlasScale;    // Shadow atlas scale (0.5 for 2x2 grid)
	float ShadowDistance;
	uint ShadowResolutionTier;
	vec2 Padding2;
};

layout(std140, set = 1, binding = 7) uniform SpotLightData
{
	uint LightCount;
	SpotLight Lights[1024];
} u_SpotLights;

// Spot-light tiles plus six per shadowed point light; matches SceneRenderer::MaxShadowAtlasTiles.
#define SHADOW_ATLAS_MAX_TILES 64

layout(std140, set = 1, binding = 8) uniform SpotShadowData
{
	mat4 Mats[SHADOW_ATLAS_MAX_TILES];
	uint Count;
	vec3 Padding;
} u_SpotLightMatrices;

