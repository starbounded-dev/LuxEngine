//
// SET 2
//

layout(std140, set = 2, binding = 0) uniform Camera
{
	mat4 ViewProjectionMatrix;
	mat4 InverseViewProjectionMatrix;
	mat4 ProjectionMatrix;
	mat4 InverseProjectionMatrix;
	mat4 ViewMatrix;
	mat4 InverseViewMatrix;
	vec2 NDCToViewMul;
	vec2 NDCToViewAdd;
	vec2 DepthUnpackConsts;
	vec2 CameraTanHalfFOV;
} u_Camera;

layout(std140, set = 2, binding = 1) uniform RendererData
{
	uniform vec4 CascadeSplits;
	uniform int TilesCountX;
	uniform bool ShowCascades;
	uniform bool SoftShadows;
	uniform float LightSize;
	uniform float MaxShadowDistance;
	uniform float ShadowFade;
	uniform bool CascadeFading;
	uniform float CascadeTransitionFade;
	uniform bool ShowLightComplexity;
	uniform bool ShowMaterialComplexity;
	uniform float TextureMipBias;
	uniform bool EnableDistanceMipBias;
	uniform float DistanceMipBiasStart;
	uniform float DistanceMipBiasEnd;
	uniform float DistanceMipBiasMax;
} u_RendererData;

layout(std140, set = 2, binding = 2) uniform ScreenData
{
    vec2 InvFullResolution;
    vec2 FullResolution;
	vec2 InvHalfResolution;
    vec2 HalfResolution;
	vec2 InvQuarterResolution;
    vec2 QuarterResolution;
} u_ScreenData;


