//
// SET 2
//

layout(std140, set = 2, binding = 0) uniform Camera
{
	mat4 ViewProjectionMatrix;
	mat4 InverseViewProjectionMatrix;
	mat4 ProjectionMatrix;
	mat4 InverseProjectionMatrix;
	mat4 ViewMatrix;
	mat4 InverseViewMatrix;
	vec2 NDCToViewMul;
	vec2 NDCToViewAdd;
	vec2 DepthUnpackConsts;
	vec2 CameraTanHalfFOV;
} u_Camera;

layout(std140, set = 2, binding = 1) uniform RendererData
{
	uniform vec4 CascadeSplits;
	uniform int TilesCountX;
	uniform bool ShowCascades;
	uniform bool SoftShadows;
	uniform float LightSize;
	uniform float MaxShadowDistance;
	uniform float ShadowFade;
	uniform bool CascadeFading;
	uniform float CascadeTransitionFade;
	uniform bool ShowLightComplexity;
	uniform bool ShowMaterialComplexity;
	uniform float TextureMipBias;
	uniform bool EnableDistanceMipBias;
	uniform float DistanceMipBiasStart;
	uniform float DistanceMipBiasEnd;
	uniform float DistanceMipBiasMax;
	uniform uint GPUSceneDebugMode;
} u_RendererData;

layout(std140, set = 2, binding = 2) uniform ScreenData
{
    vec2 InvFullResolution;
    vec2 FullResolution;
	vec2 InvHalfResolution;
    vec2 HalfResolution;
	vec2 InvQuarterResolution;
    vec2 QuarterResolution;
} u_ScreenData;

struct LocalFogVolumeData
{
	mat4 WorldToLocal;
	vec4 ColorDensity; // xyz = color, w = density
	vec4 Params0;      // x = anisotropy, y = height falloff, z = noise scale, w = noise strength
	vec4 Params1;      // x = max distance, y = edge falloff, zw = reserved
	uvec4 Metadata;    // x = shape, y = entity low bits, z = priority, w = reserved
};

layout(std140, set = 2, binding = 3) uniform AtmosphereData
{
	vec4 RayleighScattering;        // xyz = scattering, w = scale
	vec4 MieScattering;             // xyz = scattering, w = scale
	vec4 MieAbsorption;             // xyz = absorption, w = anisotropy
	vec4 Absorption;                // xyz = ozone/absorption tint, w = scale
	vec4 GroundAlbedo;              // xyz = albedo, w = ground contribution
	vec4 AtmosphereParams;          // x = planet radius, y = atmosphere height, z = rayleigh scale height, w = mie scale height
	vec4 SunParams;                 // x = intensity, y = angular radius, z = multi scattering, w = aerial perspective scale
	vec4 CloudParams0;              // x = coverage, y = density, z = altitude, w = thickness
	vec4 CloudParams1;              // x/y = wind dir, z = wind speed, w = shape scale
	vec4 CloudParams2;              // x = detail scale, y = detail strength, z = absorption, w = silver lining
	vec4 CloudColor;                // xyz = albedo, w = ambient boost
	vec4 CloudRenderParams;         // x = max trace distance, y = fade distance, z = lod start distance, w = shadow trace distance
	vec4 CloudRenderParams2;        // x = render scale divisor, yzw = reserved
	vec4 FogColorDensity;           // xyz = color, w = density
	vec4 FogParams0;                // x = height falloff, y = start distance, z = max opacity, w = cutoff distance
	vec4 FogDirectionalInscattering;// xyz = directional color, w = directional exponent
	vec4 FogParams1;                // x = directional start distance, y = volumetric scattering, z = anisotropy, w = reserved
	uvec4 Flags;                    // x = sky, y = clouds, z = fog, w = volumetric fog
	uvec4 Steps;                    // x = cloud march, y = cloud shadow, z = frame index, w = fog march
	uvec4 LocalFogParams;           // x = visible count, y = dropped count, z = culled count, w = active local fog count
	LocalFogVolumeData LocalFogVolumes[64];
} u_Atmosphere;


