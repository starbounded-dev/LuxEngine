#ifndef LUX_PBR_GLSLH
#define LUX_PBR_GLSLH

#include <Common.glslh>
#include <Samplers.glslh>
#include <MaterialSurface.glslh>

// GGX/Towbridge-Reitz normal distribution function.
// Uses Disney's reparametrization of alpha = roughness^2
float NdfGGX(float cosLh, float roughness)
{
	float alpha = roughness * roughness;
	float alphaSq = alpha * alpha;

	float denom = (cosLh * cosLh) * (alphaSq - 1.0) + 1.0;
	return alphaSq / (PI * denom * denom);
}

// Single term for separable Schlick-GGX below.
float GaSchlickG1(float cosTheta, float k)
{
	return cosTheta / (cosTheta * (1.0 - k) + k);
}

// Schlick-GGX approximation of geometric attenuation function using Smith's method.
float GaSchlickGGX(float cosLi, float NdotV, float roughness)
{
	float r = roughness + 1.0;
	float k = (r * r) / 8.0; // Epic suggests using this roughness remapping for analytic lights.
	return GaSchlickG1(cosLi, k) * GaSchlickG1(NdotV, k);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
	float r = (roughness + 1.0);
	float k = (r * r) / 8.0;

	float nom = NdotV;
	float denom = NdotV * (1.0 - k) + k;

	return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
	float NdotV = max(dot(N, V), 0.0);
	float NdotL = max(dot(N, L), 0.0);
	float ggx2 = GeometrySchlickGGX(NdotV, roughness);
	float ggx1 = GeometrySchlickGGX(NdotL, roughness);

	return ggx1 * ggx2;
}

// Shlick's approximation of the Fresnel factor.
vec3 FresnelSchlick(vec3 F0, float cosTheta)
{
	return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 FresnelSchlickRoughness(vec3 F0, float cosTheta, float roughness)
{
	return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(1.0 - cosTheta, 5.0);
}

vec3 LuxDielectricF0(float specular)
{
	return vec3(0.08 * clamp(specular, 0.0, 1.0));
}

float LuxRoughnessToReflectionMip(float roughness, int mipCount)
{
	float maxMip = max(float(mipCount - 1), 0.0);
	return clamp(roughness * maxMip, 0.0, maxMip);
}

// Lagarde's specular occlusion (Moving Frostbite to PBR). Keeps ambient specular
// from leaking through occluded/concave geometry. Pass ao = 1.0 for no occlusion.
float LuxSpecularOcclusion(float NdotV, float ao, float roughness)
{
	return clamp(pow(NdotV + ao, exp2(-16.0 * roughness - 1.0)) - 1.0 + ao, 0.0, 1.0);
}

// ---------------------------------------------------------------------------------------------
// Analytic (punctual and directional) light response. Light intensities are physical: a
// directional light's Radiance * Multiplier is illuminance, a point or spot light's is intensity
// with inverse-square falloff (PhysicalLight.h converts lux / lumens / candela into them).
// ---------------------------------------------------------------------------------------------

// GGX alpha floor so the distribution stays finite on mirror-smooth surfaces [Walter 2007].
const float LUX_MIN_GGX_ALPHA = 0.0064;
// Inverse-square floor (distance >= 0.1), so a surface touching a light does not divide by zero.
const float LUX_MIN_LIGHT_DISTANCE_SQ = 0.01;
// Specular firefly guard for delta lights; scales the whole colour so it keeps its saturation.
const float LUX_MAX_DIRECT_SPECULAR = 10.0;

float LuxRoughnessToAlpha(float roughness)
{
	return max(roughness * roughness, LUX_MIN_GGX_ALPHA);
}

float LuxDistributionGGX(float NdotH, float alpha)
{
	float a2 = alpha * alpha;
	float denom = (NdotH * NdotH) * (a2 - 1.0) + 1.0;
	return a2 / (PI * denom * denom);
}

// Height-correlated Smith masking-shadowing in visibility form, G / (4 NdotL NdotV)
// [Heitz 2014; Lagarde 2014].
float LuxVisibilitySmithGGXCorrelated(float NdotV, float NdotL, float alpha)
{
	float a2 = alpha * alpha;
	float lambdaV = NdotL * sqrt(NdotV * NdotV * (1.0 - a2) + a2);
	float lambdaL = NdotV * sqrt(NdotL * NdotL * (1.0 - a2) + a2);
	return 0.5 / max(lambdaV + lambdaL, 1e-7);
}

// Renormalized Disney diffuse, Lambert's 1/PI included [Lagarde 2014; Burley 2012].
vec3 LuxDiffuseFrostbite(vec3 albedo, float roughness, float NdotV, float NdotL, float LdotH)
{
	float energyBias = mix(0.0, 0.5, roughness);
	float energyFactor = mix(1.0, 1.0 / 1.51, roughness);
	float fd90 = energyBias + 2.0 * LdotH * LdotH * roughness;
	float lightScatter = 1.0 + (fd90 - 1.0) * pow(1.0 - NdotL, 5.0);
	float viewScatter = 1.0 + (fd90 - 1.0) * pow(1.0 - NdotV, 5.0);
	return albedo * (lightScatter * viewScatter * energyFactor / PI);
}

// Analytic split-sum (scale, bias) fit, so direct light can compute the single-scatter albedo
// without the LUT [Karis 2014, after Lazarov 2013].
vec2 LuxEnvBRDFApprox(float roughness, float NdotV)
{
	const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
	const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
	vec4 r = roughness * c0 + c1;
	float a004 = min(r.x * r.x, exp2(-9.28 * NdotV)) * r.x + r.y;
	return vec2(-1.04, 1.04) * a004 + r.zw;
}

// Multiplier (>= 1) restoring the energy a single-scatter GGX lobe loses at high roughness
// [Turquin 2019].
vec3 LuxMultiScatterCompensation(vec3 F0, float roughness, float NdotV)
{
	vec2 dfg = LuxEnvBRDFApprox(roughness, NdotV);
	float Ess = dfg.x + dfg.y;
	return 1.0 + F0 * (1.0 / max(Ess, 1e-3) - 1.0);
}

vec3 LuxPreservedSaturationClamp(vec3 color, float maxValue)
{
	float largest = max(color.r, max(color.g, color.b));
	return largest <= maxValue ? color : color * (maxValue / largest);
}

// Advanced material lobes (clearcoat, sheen, subsurface, anisotropy). LuxSetupMaterialLobes
// (MaterialLobes.glslh) sets these per pixel from the material row; g_LobeFlags stays 0 for a plain
// material and in every shader that never calls it, which then shades exactly as before. All spatial.
const uint LUX_LOBE_CLEARCOAT = 1u;
const uint LUX_LOBE_SHEEN = 2u;
const uint LUX_LOBE_SUBSURFACE = 4u;
const uint LUX_LOBE_ANISOTROPY = 8u;
uint g_LobeFlags = 0u;
float g_Clearcoat = 0.0;
float g_ClearcoatRoughness = 0.1;
vec3 g_SheenColor = vec3(0.0);
float g_SheenRoughness = 0.5;
vec3 g_SubsurfaceColor = vec3(0.0);
float g_SubsurfaceThickness = 0.5;
float g_Anisotropy = 0.0;
vec3 g_AnisotropyTangent = vec3(1.0, 0.0, 0.0);
vec3 g_AnisotropyBitangent = vec3(0.0, 1.0, 0.0);

// Sharpness of the forward-scattering lobe of subsurface light [Filament].
const float LUX_SUBSURFACE_POWER = 12.234;
// shortcut: a constant directional albedo for the sheen lobe, which scales the layer under it; a
// Charlie DFG table would make it depend on angle and roughness.
const float LUX_SHEEN_ALBEDO = 0.2;

float LuxMax3(vec3 v) { return max(v.x, max(v.y, v.z)); }

// Anisotropic GGX: distribution and height-correlated visibility [Burley 2012; Heitz 2014; Filament].
float LuxDistributionGGXAnisotropic(float at, float ab, float ToH, float BoH, float NoH)
{
	float a2 = at * ab;
	vec3 v = vec3(ab * ToH, at * BoH, a2 * NoH);
	float w2 = a2 / max(dot(v, v), 1e-7);
	return a2 * w2 * w2 / PI;
}

float LuxVisibilityGGXAnisotropic(float at, float ab, float ToV, float BoV, float ToL, float BoL, float NoV, float NoL)
{
	float lambdaV = NoL * length(vec3(at * ToV, ab * BoV, NoV));
	float lambdaL = NoV * length(vec3(at * ToL, ab * BoL, NoL));
	return 0.5 / max(lambdaV + lambdaL, 1e-7);
}

// Sheen: "Charlie" distribution [Estevez & Kulla 2017] and Neubelt visibility [Neubelt 2013].
float LuxDistributionCharlie(float roughness, float NoH)
{
	float invAlpha = 1.0 / max(roughness * roughness, 1e-3);
	float sin2h = max(1.0 - NoH * NoH, 0.0078125);
	return (2.0 + invAlpha) * pow(sin2h, invAlpha * 0.5) / (2.0 * PI);
}

float LuxVisibilityNeubelt(float NoV, float NoL)
{
	return 1.0 / max(4.0 * (NoL + NoV - NoL * NoV), 1e-4);
}

float LuxSheenScaling()
{
	return 1.0 - LuxMax3(g_SheenColor) * LUX_SHEEN_ALBEDO;
}

// Outgoing radiance per unit of light illuminance arriving from direction L, cosine included.
vec3 LuxEvaluateDirectBRDF(vec3 F0, vec3 albedo, float metalness, float roughness, vec3 N, vec3 V, vec3 L)
{
	float NdotLSigned = dot(N, L);
	float NdotL = max(NdotLSigned, 0.0);
	// Subsurface light also reaches the side facing away from the light.
	bool subsurface = (g_LobeFlags & LUX_LOBE_SUBSURFACE) != 0u;
	if (NdotL <= 0.0 && !subsurface)
		return vec3(0.0);

	vec3 H = normalize(L + V);
	float NdotV = max(dot(N, V), 1e-4);
	float NdotH = max(dot(N, H), 0.0);
	float VdotH = max(dot(V, H), 0.0);

	vec3 F = F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
	float alpha = LuxRoughnessToAlpha(roughness);

	vec3 diffuse = (1.0 - F) * (1.0 - metalness) * LuxDiffuseFrostbite(albedo, roughness, NdotV, NdotL, VdotH);
	float specularDV;
	if ((g_LobeFlags & LUX_LOBE_ANISOTROPY) != 0u)
	{
		float at = max(alpha * (1.0 + g_Anisotropy), LUX_MIN_GGX_ALPHA);
		float ab = max(alpha * (1.0 - g_Anisotropy), LUX_MIN_GGX_ALPHA);
		vec3 T = g_AnisotropyTangent;
		vec3 B = g_AnisotropyBitangent;
		specularDV = LuxDistributionGGXAnisotropic(at, ab, dot(T, H), dot(B, H), NdotH)
			* LuxVisibilityGGXAnisotropic(at, ab, dot(T, V), dot(B, V), dot(T, L), dot(B, L), NdotV, NdotL);
	}
	else
	{
		specularDV = LuxDistributionGGX(NdotH, alpha) * LuxVisibilitySmithGGXCorrelated(NdotV, NdotL, alpha);
	}
	vec3 specular = specularDV * F * LuxMultiScatterCompensation(F0, roughness, NdotV);
	specular = LuxPreservedSaturationClamp(specular, LUX_MAX_DIRECT_SPECULAR);

	if (g_LobeFlags == 0u)
		return (diffuse + specular) * NdotL;

	// Subsurface [Filament]: energy-conserving wrapped diffuse, plus light scattered through the
	// material, forward toward the viewer and back out, less of it the thicker the material.
	vec3 result;
	if (subsurface)
	{
		result = diffuse * clamp((NdotLSigned + 0.5) / 2.25, 0.0, 1.0) + specular * NdotL;
		float forwardScatter = exp2(clamp(dot(V, -L), 0.0, 1.0) * LUX_SUBSURFACE_POWER - LUX_SUBSURFACE_POWER);
		float backScatter = clamp(NdotLSigned * g_SubsurfaceThickness + (1.0 - g_SubsurfaceThickness), 0.0, 1.0) * 0.5;
		float scatter = mix(backScatter, 1.0, forwardScatter) * (1.0 - g_SubsurfaceThickness);
		result += g_SubsurfaceColor * (scatter / PI);
	}
	else
	{
		result = (diffuse + specular) * NdotL;
	}

	if (NdotL > 0.0 && (g_LobeFlags & LUX_LOBE_SHEEN) != 0u)
	{
		float sheen = LuxDistributionCharlie(g_SheenRoughness, NdotH) * LuxVisibilityNeubelt(NdotV, NdotL);
		result = result * LuxSheenScaling() + g_SheenColor * (sheen * NdotL);
	}

	// Clearcoat [Kelemen 2001 visibility; Filament]: a dielectric layer (F0 4%) on top, which takes
	// its Fresnel share from everything under it.
	if (NdotL > 0.0 && (g_LobeFlags & LUX_LOBE_CLEARCOAT) != 0u)
	{
		float coatAlpha = LuxRoughnessToAlpha(g_ClearcoatRoughness);
		float Fc = (0.04 + 0.96 * pow(1.0 - VdotH, 5.0)) * g_Clearcoat;
		float coat = LuxDistributionGGX(NdotH, coatAlpha) * (0.25 / max(VdotH * VdotH, 1e-4)) * Fc;
		result = result * (1.0 - Fc) + vec3(min(coat, LUX_MAX_DIRECT_SPECULAR) * NdotL);
	}

	return result;
}

// Inverse-square falloff windowed to reach exactly zero at the light's range [Karis 2013].
float LuxPunctualLightAttenuation(float distanceSq, float range)
{
	float ratio = distanceSq / max(range * range, 1e-4);
	float window = clamp(1.0 - ratio * ratio, 0.0, 1.0);
	return (window * window) / max(distanceSq, LUX_MIN_LIGHT_DISTANCE_SQ);
}

// Energy-preserving image-based lighting (single + multiple scattering), after
// Carmelo J. Fdez-Agera, "A Multiple-Scattering Microfacet Model for Real-Time
// Image-based Lighting". The multiple-scattering term re-introduces the energy a
// single specular bounce loses, which is what otherwise leaves rough metals and
// dielectrics looking dull and flat. 'ambientOcclusion' attenuates the diffuse
// term and drives specular occlusion; pass 1.0 for none.
vec3 LuxEvaluateImageBasedLighting(
	textureCube envRadiance,
	textureCube envIrradiance,
	texture2D brdfLut,
	vec3 normal,
	vec3 reflectionDirection,
	vec3 albedo,
	float roughness,
	float metalness,
	float NdotV,
	vec3 F0,
	float envMapRotation,
	float ambientOcclusion)
{
	roughness = clamp(roughness, 0.045, 1.0);
	metalness = clamp(metalness, 0.0, 1.0);
	NdotV = clamp(NdotV, 0.0, 1.0);
	float ao = clamp(ambientOcclusion, 0.0, 1.0);

	vec3 irradiance = SampleLinear(envIrradiance, RotateVectorAboutY(envMapRotation, normal)).rgb;

	int envRadianceMipCount = textureQueryLevels(samplerCube(envRadiance, r_LinearSampler));
	float reflectionMip = LuxRoughnessToReflectionMip(roughness, envRadianceMipCount);
	vec3 reflectionVector = RotateVectorAboutY(envMapRotation, normalize(reflectionDirection));
	vec3 specularIrradiance = SampleLinearLOD(envRadiance, reflectionVector, reflectionMip).rgb;

	// Mip 0: (NdotV, roughness) is not a screen UV, so derivative-based LOD would pick arbitrary mips
	// at silhouettes and on normal-mapped detail, banding along NdotV contours.
	vec2 brdf = SampleLinearLOD(brdfLut, vec2(NdotV, roughness), 0.0).rg;

	// Single-scattering specular reflectance (FssEss) and white-furnace energy (Ess).
	vec3 Fr = max(vec3(1.0 - roughness), F0) - F0;
	vec3 kS = F0 + Fr * pow(1.0 - NdotV, 5.0);
	vec3 FssEss = kS * brdf.x + brdf.y;
	float Ess = brdf.x + brdf.y;
	float Ems = 1.0 - Ess;

	// Multiple-scattering specular energy compensation.
	vec3 Favg = F0 + (1.0 - F0) / 21.0;
	vec3 Fms = FssEss * Favg / (1.0 - Ems * Favg);

	// Diffuse receives the remaining (non-specular) energy.
	vec3 Edss = 1.0 - (FssEss + Fms * Ems);
	vec3 kD = albedo * (1.0 - metalness) * Edss;

	float specularOcclusion = LuxSpecularOcclusion(NdotV, ao, roughness);
	vec3 specularIBL = FssEss * specularIrradiance * specularOcclusion;
	vec3 diffuseIBL = (Fms * Ems + kD) * irradiance * ao;

	return diffuseIBL + specularIBL;
}

// Backwards-compatible overload without explicit occlusion (ao = 1.0).
vec3 LuxEvaluateImageBasedLighting(
	textureCube envRadiance,
	textureCube envIrradiance,
	texture2D brdfLut,
	vec3 normal,
	vec3 reflectionDirection,
	vec3 albedo,
	float roughness,
	float metalness,
	float NdotV,
	vec3 F0,
	float envMapRotation)
{
	return LuxEvaluateImageBasedLighting(
		envRadiance, envIrradiance, brdfLut, normal, reflectionDirection, albedo,
		roughness, metalness, NdotV, F0, envMapRotation, 1.0);
}

#endif // LUX_PBR_GLSLH




