Project:
  Name: Sandbox
  AssetDirectory: Assets
  AssetRegistry: Assets/AssetRegistry.lzr
  AudioCommandsRegistryPath: AudioCommandsRegistry.lzr
  MeshPath: Meshes
  MeshSourcePath: Meshes/Source
  AnimationPath: Animation
  ScriptModulePath: Scripts/Binaries/Sandbox.dll
  DefaultNamespace: Sandbox
  StartScene: ""
  AutomaticallyReloadAssembly: true
  AutoSave: true
  AutoSaveInterval: 300
  RenderingTechnique: Forward
  SceneRenderer:
    Rendering:
      FrustumCulling: true
      GPUDrivenRendering: true
      GTAO: true
      GTAOBentNormals: true
      GTAODenoisePasses: 8
      AOShadowTolerance: 4
      SSR: true
      JumpFloodOutline: true
    Shadows:
      SoftShadows: true
      MaxDistance: 200
      DistanceFade: 25
      SplitLambda: 0.920000017
      NearOffset: 0
      FarOffset: 50
      CascadeFade: 1
    PostFX:
      Bloom:
        Enabled: true
        Threshold: 1
        Knee: 0.100000001
        UpsampleScale: 1
        Intensity: 1
        DirtIntensity: 1
      DOF:
        Enabled: true
        FocusDistance: 4
        BlurSize: 0.75
      SSR:
        HalfRes: true
        MaxSteps: 70
        Brightness: 0.699999988
        DepthTolerance: 0.800000012
  Audio:
    FileStreamingDurationThreshold: 1
  Physics:
    FixedTimestep: 0.0166666675
    Gravity: [0, -9.81000042, 0]
    SolverPositionIterations: 8
    SolverVelocityIterations: 2
    MaxBodies: 1000
    CaptureOnPlay: true
    CaptureMethod: LiveDebug
  Log:
    Animation:
      Enabled: true
      LevelFilter: Warn
    Asset Pack:
      Enabled: true
      LevelFilter: Warn
    AssetManager:
      Enabled: true
      LevelFilter: Info
    AssetSystem:
      Enabled: true
      LevelFilter: Info
    Assimp:
      Enabled: true
      LevelFilter: Error
    Audio:
      Enabled: true
      LevelFilter: Error
    Core:
      Enabled: true
      LevelFilter: Trace
    GLFW:
      Enabled: true
      LevelFilter: Error
    Memory:
      Enabled: true
      LevelFilter: Error
    Mesh:
      Enabled: true
      LevelFilter: Warn
    Physics:
      Enabled: true
      LevelFilter: Warn
    Project:
      Enabled: true
      LevelFilter: Warn
    Renderer:
      Enabled: true
      LevelFilter: Info
    Scene:
      Enabled: true
      LevelFilter: Info
    Scripting:
      Enabled: true
      LevelFilter: Warn
    Sound Spatializer:
      Enabled: true
      LevelFilter: Warn
    Timer:
      Enabled: false
      LevelFilter: Trace
    miniaudio:
      Enabled: true
      LevelFilter: Error