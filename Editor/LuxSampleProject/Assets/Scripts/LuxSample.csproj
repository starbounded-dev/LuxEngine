<Project Sdk="Microsoft.NET.Sdk">
	<!-- SDK-style counterpart to premake5.lua in this folder. The editor's ScriptBuilder
	     shells `dotnet build` on this file, so it works on Linux and Windows alike.
	     References the pre-built ScriptCore.dll and Coral.Managed.dll - it does not rebuild them. -->
	<PropertyGroup>
		<OutputType>Library</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<AssemblyName>LuxSample</AssemblyName>
		<RootNamespace>LuxSample</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<OutputPath>Binaries</OutputPath>
		<!-- BaseIntermediateOutputPath lives in Directory.Build.props; it must be set before
		     Microsoft.Common.props is imported to take effect. -->
	</PropertyGroup>

	<!-- Match premake's explicit file list. The SDK default glob (**/*.cs) would also sweep
	     up generated sources under Binaries/ and Intermediates/. -->
	<PropertyGroup>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Source/**/*.cs" />
		<Compile Include="Properties/**/*.cs" />
	</ItemGroup>

	<!-- Private=false (Copy Local = off) is REQUIRED. The host already has ScriptCore and
	     Coral.Managed loaded; copying them next to LuxSample.dll makes the load context resolve
	     a SECOND ScriptCore, so a script's base Lux.Entity is a different type identity than the
	     host's. IsSubclassOf(Lux.Entity) then fails in ScriptEngine::BuildAssemblyCache and the
	     script is silently never registered or run. -->
	<ItemGroup>
		<Reference Include="ScriptCore">
			<HintPath>../../../../Editor/Resources/Scripts/ScriptCore.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Coral.Managed">
			<HintPath>../../../../Editor/DotNet/Coral.Managed.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
</Project>
