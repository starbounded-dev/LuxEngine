Project:
  Name: LuxSample
  AssetDirectory: Assets
  AssetRegistry: Assets/AssetRegistry.lzr
  AudioCommandsRegistryPath: AudioCommandsRegistry.lzr
  MeshPath: Meshes
  MeshSourcePath: Meshes/Source
  AnimationPath: Animation
  ScriptModulePath: Scripts/Binaries/LuxSample.dll
  DefaultNamespace: LuxSample
  StartScene: Scenes/FMODDemo.luxscene
  AutomaticallyReloadAssembly: true
  AutoSave: true
  AutoSaveInterval: 300
  RuntimeExport:
    GameName: LuxSample
    WindowWidth: 1920
    WindowHeight: 1080
    Fullscreen: true
    VSync: false
    IconPath: Textures/luxLogo.png
    IconHandle: 3523050505664199236
    TargetConfig: Release
  SceneRenderer:
    Rendering:
      QualityPreset: Cinematic
      FrustumCulling: true
      OcclusionCulling: false
      GPUDrivenRendering: true
      MeshLODs: true
      MeshLODDistanceScale: 1
      VariableRateShading: true
      MeshShaders: true
      GTAO: true
      GTAOBentNormals: true
      GTAODenoisePasses: 8
      GTAOSliceCount: 9
      GTAOStepsPerSlice: 3
      AOShadowTolerance: 1
      SSR: false
      JumpFloodOutline: true
      RenderScaleMode: Scale100
      FixedRenderWidth: 1920
      FixedRenderHeight: 1080
      DynamicResolutionMinScale: 0.5
      DynamicResolutionMaxScale: 1
      DynamicResolutionTargetGPUTime: 16.6700001
      TextureMipBias: -1.5
      DistanceMipBias: true
      DistanceMipBiasStart: 10
      DistanceMipBiasEnd: 100
      DistanceMipBiasMax: 0.5
      OcclusionDepthBias: 0.00300000003
      OcclusionBoundsScale: 1.14999998
      GTAOResolutionScale: 1
      SSRQuality: Full
      SSRResolutionScale: 1
      SMAA: true
      SMAAThreshold: 0.100000001
      SMAALocalContrastAdaptationFactor: 2
    Shadows:
      SoftShadows: true
      ShadowCulling: true
      MaxDistance: 450
      DistanceFade: 50
      ActiveCascadeCount: 4
      SplitLambda: 0.819999993
      NearOffset: 0
      FarOffset: 50
      CascadeFade: 1
      FilterMode: 2
      DirectionalPCSSCascades: 2
      PCFRadiusTexels: 1.75
      SpotPCFRadiusTexels: 2
      ResolutionLimit: 2K
    PostFX:
      Bloom:
        Enabled: true
        ResolutionScale: 1
        Threshold: 1
        Knee: 0.100000001
        UpsampleScale: 1
        Intensity: 1
        DirtIntensity: 1
      DOF:
        Enabled: true
        ResolutionScale: 1
        FocusDistance: 5.0999999
        BlurSize: 0.600000024
      SSR:
        HalfRes: false
        MaxSteps: 128
        Brightness: 0.699999988
        DepthTolerance: 0.800000012
  Audio:
    FileStreamingDurationThreshold: 1
    StudioProjectPath: Audio/SampleProject/SampleProject.fspro
    StudioPlatform: Desktop
    Windows:
      Enabled: false
      StudioPlatform: Desktop
      BankOutputPath: Build/Desktop
      Performance:
        MuteWhenUnfocused: false
        RealVoices: 64
        CPUPercent: 5
        RaytracingMilliseconds: 2
        BankMemoryMiB: 64
        BusVoices:
          bus:/: 64
    Linux:
      Enabled: false
      StudioPlatform: Desktop
      BankOutputPath: Build/Desktop
      Performance:
        MuteWhenUnfocused: false
        RealVoices: 64
        CPUPercent: 5
        RaytracingMilliseconds: 2
        BankMemoryMiB: 64
        BusVoices:
          bus:/: 64
    StudioBankOutputPath: Build/Desktop
    RebuildBanksOnPlay: true
    EnableLiveUpdate: true
    AcousticMaterials:
      {}
    SurfaceTable: 0
    DialogueTable: 0
    DialogueLanguage: en
    Accessibility:
      Version: 1
      BuiltInUI: true
      DefaultLanguage: en
      DescriptionDuck: 0.25
      Defaults:
        Subtitles: true
        Captions: false
        VisualCues: false
        SpeakerNames: true
        DirectionIndicators: true
        Mono: false
        AudioDescriptions: false
        TextSize: 24
        BackgroundOpacity: 0.75
        DurationMultiplier: 1
        MaxLines: 3
        DialogueBoost: 1
        DynamicRange: 0
        Volumes:
          Master: 1
          Music: 1
          SFX: 1
          Dialogue: 1
          UI: 1
          Ambience: 1
      Buses:
        Master: bus:/
        Music: ""
        SFX: ""
        Dialogue: ""
        UI: ""
        Ambience: ""
      Events:
        {}
      SpeakerColors:
        {}
    Performance:
      MuteWhenUnfocused: false
      RealVoices: 64
      CPUPercent: 5
      RaytracingMilliseconds: 2
      BankMemoryMiB: 64
      BusVoices:
        bus:/: 64
    ZoneReverbMode: 0
  Physics:
    FixedTimestep: 0.0166666675
    Gravity: [0, -9.81000042, 0]
    SolverPositionIterations: 8
    SolverVelocityIterations: 2
    MaxBodies: 1000
    CaptureOnPlay: true
    CaptureMethod: LiveDebug
  Log:
    Animation:
      Enabled: true
      LevelFilter: Warn
    Asset Pack:
      Enabled: true
      LevelFilter: Warn
    AssetManager:
      Enabled: true
      LevelFilter: Info
    AssetSystem:
      Enabled: true
      LevelFilter: Info
    Assimp:
      Enabled: true
      LevelFilter: Error
    Audio:
      Enabled: true
      LevelFilter: Info
    Core:
      Enabled: true
      LevelFilter: Trace
