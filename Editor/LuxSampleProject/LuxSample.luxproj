Project:
  Name: LuxSample
  AssetDirectory: Assets
  AssetRegistry: Assets/AssetRegistry.lzr
  AudioCommandsRegistryPath: AudioCommandsRegistry.lzr
  MeshPath: Meshes
  MeshSourcePath: Meshes/Source
  AnimationPath: Animation
  ScriptModulePath: Scripts/Binaries/LuxSample.dll
  DefaultNamespace: LuxSample
  StartScene: Scenes/NewSceneSystem.luxscene
  AutomaticallyReloadAssembly: true
  AutoSave: true
  AutoSaveInterval: 300
  RuntimeExport:
    GameName: LuxSample
    WindowWidth: 1920
    WindowHeight: 1080
    Fullscreen: false
    VSync: false
    IconPath: Textures/luxLogo.png
    IconHandle: 10706518493978196728
    TargetConfig: Release
  SceneRenderer:
    Rendering:
      QualityPreset: Cinematic
      FrustumCulling: true
      OcclusionCulling: false
      GPUDrivenRendering: true
      MeshLODs: true
      MeshLODDistanceScale: 1
      VariableRateShading: true
      MeshShaders: true
      GTAO: true
      GTAOBentNormals: true
      GTAODenoisePasses: 8
      AOShadowTolerance: 1
      SSR: false
      JumpFloodOutline: true
      RenderScaleMode: Scale100
      DynamicResolutionMinScale: 0.5
      DynamicResolutionMaxScale: 1
      DynamicResolutionTargetGPUTime: 16.6700001
      TextureMipBias: -4
      DistanceMipBias: true
      DistanceMipBiasStart: 10
      DistanceMipBiasEnd: 100
      DistanceMipBiasMax: 0.5
      OcclusionDepthBias: 0.00300000003
      OcclusionBoundsScale: 1.14999998
      GTAOResolutionScale: 1
      GTAOTemporalAccumulation: false
      GTAOTemporalBlend: 0.949999988
      SSRQuality: Full
      SSRResolutionScale: 1
      SSRTemporalAccumulation: false
      SSRTemporalBlend: 0.949999988
    Shadows:
      SoftShadows: true
      ShadowCulling: true
      MaxDistance: 450
      DistanceFade: 50
      ActiveCascadeCount: 3
      SplitLambda: 0.920000017
      NearOffset: 0
      FarOffset: 50
      CascadeFade: 1
      FilterMode: 2
      DirectionalPCSSCascades: 1
      PCFRadiusTexels: 1.25
      SpotPCFRadiusTexels: 1.5
      ResolutionLimit: 8K
    PostFX:
      Bloom:
        Enabled: true
        ResolutionScale: 1
        Threshold: 0.200000003
        Knee: 0.159999996
        UpsampleScale: 0
        Intensity: 1.01999998
        DirtIntensity: 2.6099999
      DOF:
        Enabled: true
        ResolutionScale: 1
        FocusDistance: 5.0999999
        BlurSize: 0.600000024
      SSR:
        HalfRes: false
        MaxSteps: 256
        Brightness: 1.07000005
        DepthTolerance: 0.629999995
  Audio:
    FileStreamingDurationThreshold: 1
  Physics:
    FixedTimestep: 0.0166666675
    Gravity: [0, -9.81000042, 0]
    SolverPositionIterations: 8
    SolverVelocityIterations: 2
    MaxBodies: 1000
    CaptureOnPlay: true
    CaptureMethod: LiveDebug
  Log:
    Animation:
      Enabled: true
      LevelFilter: Warn
    Asset Pack:
      Enabled: true
      LevelFilter: Warn
    AssetManager:
      Enabled: true
      LevelFilter: Info
    AssetSystem:
      Enabled: true
      LevelFilter: Info
    Assimp:
      Enabled: true
      LevelFilter: Error
    Audio:
      Enabled: true
      LevelFilter: Error
    Core:
      Enabled: true
      LevelFilter: Trace
    GLFW:
      Enabled: true
      LevelFilter: Error
    Memory:
      Enabled: true
      LevelFilter: Error
    Mesh:
      Enabled: true
      LevelFilter: Warn
    Physics:
      Enabled: true
      LevelFilter: Warn
    Project:
      Enabled: true
      LevelFilter: Warn
    RenderGraph:
      Enabled: true
      LevelFilter: Trace
    Renderer:
      Enabled: true
      LevelFilter: Info
    Scene:
      Enabled: true
      LevelFilter: Info
    Scripting:
      Enabled: true
      LevelFilter: Warn
    Sound Spatializer:
      Enabled: true
      LevelFilter: Warn
    Timer:
      Enabled: false
      LevelFilter: Trace
    miniaudio:
      Enabled: true
      LevelFilter: Error