    Physics:
      Enabled: true
      LevelFilter: Warn
    Project:
      Enabled: true
      LevelFilter: Warn
    RenderGraph:
      Enabled: true
      LevelFilter: Trace
    Renderer:
      Enabled: true
      LevelFilter: Info
    Scene:
      Enabled: true
      LevelFilter: Info
    Scripting:
      Enabled: true
      LevelFilter: Warn
    Sound Spatializer:
      Enabled: true
      LevelFilter: Warn
    Timer:
      Enabled: false
      LevelFilter: Trace
    miniaudio:
      Enabled: true
